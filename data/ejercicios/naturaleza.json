          {"ru": "В лес мно́го дере́вьев.", "fonetica": "v lies MNO-ga di-RIE-vief", "correcta": false, "porque": "Para decir dónde, лес cambia: в лесу́."}
        ]},
        {"de": "Лена", "ru": "Там есть цвето́к?", "fonetica": "tam iest' tsvi-TOK", "es": "¿Hay una flor allá?"},
