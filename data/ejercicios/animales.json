  "dialogos": [
    {
      "id": "animales-d1",
      "desde": "g-u-menya-est",
      "titulo": "Mi mascota",
      "mensajes": [
        {"de": "Ле́на", "ru": "У тебя́ есть живо́тное?", "fonetica": "u tie-BIA iest' zhy-VOT-na-ie", "es": "¿Tienes algún animal?"},
        {"de": "yo", "ru": "Да, у меня́ есть ко́шка.", "fonetica": "da, u mie-NIA iest' KOSH-ka", "es": "Sí, tengo una gata.", "opciones": [
          {"ru": "Да, у меня́ есть ко́шка.", "fonetica": "da, u mie-NIA iest' KOSH-ka", "correcta": true, "porque": "¡Bien! ко́шка es la gata."},
          {"ru": "Да, у меня́ есть кот.", "fonetica": "da, u mie-NIA iest' kot", "correcta": false, "porque": "кот es un gato macho; tienes una gata: ко́шка."},
          {"ru": "Да, я есть ко́шка.", "fonetica": "da, ia iest' KOSH-ka", "correcta": false, "porque": "«Tengo» se dice у меня́ есть, no я есть."}
        ]},
        {"de": "Ле́на", "ru": "Как её зову́т?", "fonetica": "kak ie-IO za-VUT", "es": "¿Cómo se llama ella?"},
        {"de": "yo", "ru": "Её зову́т Му́рка.", "fonetica": "ie-IO za-VUT MUR-ka", "es": "Se llama Murka.", "opciones": [
          {"ru": "Её зову́т Му́рка.", "fonetica": "ie-IO za-VUT MUR-ka", "correcta": true, "porque": "¡Eso! Es una gata: её."},
          {"ru": "Его́ зову́т Му́рка.", "fonetica": "ie-VO za-VUT MUR-ka", "correcta": false, "porque": "его́ es para un macho; tu gata es она́: её."},
          {"ru": "Она́ зову́т Му́рка.", "fonetica": "a-NA za-VUT MUR-ka", "correcta": false, "porque": "зову́т pide её («a ella la llaman»), no она́."}
        ]},
        {"de": "Ле́на", "ru": "Как краси́во!", "fonetica": "kak kra-SI-va", "es": "¡Qué bonito!"}
      ]
    },
    {
      "id": "animales-d2",
      "titulo": "¿Perro o gato?",
      "mensajes": [
        {"de": "Ле́на", "ru": "Э́то соба́ка и́ли ко́шка?", "fonetica": "E-ta sa-BA-ka I-li KOSH-ka", "es": "¿Es perro o gata?"},
        {"de": "yo", "ru": "Э́то не соба́ка, э́то ко́шка.", "fonetica": "E-ta nie sa-BA-ka, E-ta KOSH-ka", "es": "No es perro, es gata.", "opciones": [
          {"ru": "Э́то не соба́ка, э́то ко́шка.", "fonetica": "E-ta nie sa-BA-ka, E-ta KOSH-ka", "correcta": true, "porque": "¡Bien! не va justo antes de lo que niegas."},
          {"ru": "Э́то нет соба́ка, э́то ко́шка.", "fonetica": "E-ta niet sa-BA-ka, E-ta KOSH-ka", "correcta": false, "porque": "Para negar una palabra se usa не, no нет."},
          {"ru": "Э́то не соба́ка, э́то кот.", "fonetica": "E-ta nie sa-BA-ka, E-ta kot", "correcta": false, "porque": "кот es un gato macho; aquí es una gata: ко́шка."}
        ]},
        {"de": "Ле́на", "ru": "А э́то волк?", "fonetica": "a E-ta volk", "es": "¿Y esto es un lobo?"},
        {"de": "yo", "ru": "Нет, э́то не волк, э́то соба́ка.", "fonetica": "niet, E-ta nie volk, E-ta sa-BA-ka", "es": "No, no es un lobo, es un perro.", "opciones": [
          {"ru": "Нет, э́то не волк, э́то соба́ка.", "fonetica": "niet, E-ta nie volk, E-ta sa-BA-ka", "correcta": true, "porque": "¡Exacto! Empiezas con нет y luego dices lo que sí es."},
          {"ru": "Да, э́то не волк, э́то соба́ка.", "fonetica": "da, E-ta nie volk, E-ta sa-BA-ka", "correcta": false, "porque": "Si lo niegas, empiezas con нет."},
          {"ru": "Нет, э́то не волк, э́то лев.", "fonetica": "niet, E-ta nie volk, E-ta liev", "correcta": false, "porque": "лев es león; la respuesta es соба́ка (perro)."}
        ]},
        {"de": "Ле́на", "ru": "А, соба́ка!", "fonetica": "a, sa-BA-ka", "es": "¡Ah, un perro!"}
      ]
    },
    {
      "id": "animales-d3",
      "extra": true,
      "titulo": "Flora y fauna",
      "mensajes": [
        {"de": "Ди́ма", "ru": "Что э́то? Живо́тное?", "fonetica": "shto E-ta? zhy-VOT-na-ie", "es": "¿Qué es esto? ¿Un animal?"},
        {"de": "yo", "ru": "Нет, э́то расте́ние.", "fonetica": "niet, E-ta ras-TIE-ni-ie", "es": "No, es una planta.", "opciones": [
          {"ru": "Нет, э́то расте́ние.", "fonetica": "niet, E-ta ras-TIE-ni-ie", "correcta": true, "porque": "¡Bien! расте́ние = planta."},
          {"ru": "Да, э́то расте́ние.", "fonetica": "da, E-ta ras-TIE-ni-ie", "correcta": false, "porque": "No es un animal, así que empiezas con нет."},
          {"ru": "Нет, э́то живо́тное.", "fonetica": "niet, E-ta zhy-VOT-na-ie", "correcta": false, "porque": "Dices нет pero repites lo mismo. Es una planta: расте́ние."}
        ]},
        {"de": "Ди́ма", "ru": "А пито́н и я́щерица? Э́то фло́ра?", "fonetica": "a pi-TON i IA-shchi-ri-tsa? E-ta FLO-ra", "es": "¿Y la pitón y la lagartija? ¿Son flora?"},
        {"de": "yo", "ru": "Нет, э́то фа́уна. Э́то пресмыка́ющиеся.", "fonetica": "niet, E-ta FA-u-na. E-ta pries-my-KA-iu-shchi-ie-sia", "es": "No, son fauna. Son reptiles.", "opciones": [
          {"ru": "Нет, э́то фа́уна. Э́то пресмыка́ющиеся.", "fonetica": "niet, E-ta FA-u-na. E-ta pries-my-KA-iu-shchi-ie-sia", "correcta": true, "porque": "¡Exacto! Los animales son фа́уна, y пито́н y я́щерица son reptiles: пресмыка́ющиеся."},
          {"ru": "Да, э́то фло́ра. Э́то пресмыка́ющиеся.", "fonetica": "da, E-ta FLO-ra. E-ta pries-my-KA-iu-shchi-ie-sia", "correcta": false, "porque": "фло́ра son las plantas; los animales son фа́уна."},
          {"ru": "Нет, э́то фа́уна. Э́то пти́цы.", "fonetica": "niet, E-ta FA-u-na. E-ta PTI-tsy", "correcta": false, "porque": "пти́цы son aves. La pitón y la lagartija son reptiles: пресмыка́ющиеся."}
        ]},
        {"de": "Ди́ма", "ru": "А у тебя́ есть дома́шние живо́тные?", "fonetica": "a u tie-BIA iest' da-MASH-ni-ie zhy-VOT-ny-ie", "es": "¿Y tú tienes mascotas?"},
        {"de": "yo", "ru": "Да, у меня́ есть пти́чка.", "fonetica": "da, u mie-NIA iest' PTICH-ka", "es": "Sí, tengo un pajarito.", "opciones": [
          {"ru": "Да, у меня́ есть пти́чка.", "fonetica": "da, u mie-NIA iest' PTICH-ka", "correcta": true, "porque": "¡Muy bien! у меня́ есть = tengo."},
          {"ru": "Да, я есть пти́чка.", "fonetica": "da, ia iest' PTICH-ka", "correcta": false, "porque": "«Tengo» se dice у меня́ есть; я есть no se usa así."},
          {"ru": "Нет, у меня́ есть пти́чка.", "fonetica": "niet, u mie-NIA iest' PTICH-ka", "correcta": false, "porque": "Dices нет, pero luego dices que sí tienes: empiezas con да."}
        ]},
        {"de": "Ди́ма", "ru": "Как ми́ло!", "fonetica": "kak MI-la", "es": "¡Qué lindo!"}
      ]
    }
  ],
