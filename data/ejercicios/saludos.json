          {"ru": "Добро́ пожа́ловать!", "fonetica": "dab-RO pa-ZHA-la-vat'", "correcta": false, "porque": "Es una bienvenida: se dice al recibir a alguien, no al despedirse."},
          {"ru": "Приве́т!", "fonetica": "pri-VIET", "correcta": false, "porque": "приве́т es para saludar; ella se está despidiendo."}
