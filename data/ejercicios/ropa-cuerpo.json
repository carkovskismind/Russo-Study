          {"ru": "Э́то твои́ футбо́лка.", "fonetica": "E-ta tva-I fud-BOL-ka", "correcta": false, "porque": "твои́ es plural; футбо́лка es una sola: твоя́."}
        ]},
        {"de": "Лена", "ru": "Спаси́бо!", "fonetica": "spa-SI-ba", "es": "¡Gracias!"}
      ]
