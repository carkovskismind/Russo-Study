      "cajas": ["он", "она́"],
      "cajas_es": ["él (masculino)", "ella (femenino)"],
      "cajas_uso": ["Para palabras masculinas: casi siempre terminan en consonante.", "Para palabras femeninas: casi siempre terminan en -а o -я."],
      "items": [
        {"ru": "класс", "caja": "он", "porque": "Es el salón o el grupo (la lección es уро́к). Termina en consonante: он.", "es": "salón de clases"},
        {"ru": "го́лос", "caja": "он", "porque": "No es «goloso», es la voz. Termina en consonante: он.", "es": "voz"},
        {"ru": "вид", "caja": "он", "porque": "No es la vid (planta), es la vista o el aspecto. Termina en consonante: он.", "es": "vista"},
        {"ru": "магази́н", "caja": "он", "porque": "No es una revista: es la tienda. Termina en consonante: он.", "es": "tienda"},
        {"ru": "ко́фе", "caja": "он", "porque": "Es la bebida. Termina en -е, pero es masculino: он.", "es": "café"},
        {"ru": "рука́", "caja": "она́", "porque": "Una sola palabra para mano y brazo. Termina en -а: она́.", "es": "mano / brazo"},
        {"ru": "фами́лия", "caja": "она́", "porque": "Es el apellido, no la familia (семья́). Termina en -я: она́.", "es": "apellido"},
        {"ru": "ра́на", "caja": "она́", "porque": "Es una herida, no una rana. Termina en -а: она́.", "es": "herida"},
        {"ru": "ка́рта", "caja": "она́", "porque": "Es un mapa o una tarjeta, no una carta. Termina en -а: она́.", "es": "mapa / tarjeta"}
      ]
    }
  ]
