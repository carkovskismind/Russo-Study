        {"ru": "Там ра́но.", "caja": "temprano", "porque": "Dice que allá todavía es temprano."},
        {"ru": "Э́то ра́на.", "caja": "herida", "porque": "Es una herida."},
        {"ru": "Здесь ра́но.", "caja": "temprano", "porque": "Dice que es temprano."},
        {"ru": "Там ра́на.", "caja": "herida", "porque": "Dice que hay una herida."}
      ]
    },
    {
