  "dialogos": [
    {
      "id": "falsos-amigos-d1",
      "titulo": "En la cafetería",
      "mensajes": [
        {"de": "Ле́на", "ru": "Где ты?", "fonetica": "gdie ty", "es": "¿Dónde estás?"},
        {"de": "yo", "ru": "Я в кафе́.", "fonetica": "ia f ka-FE", "es": "Estoy en la cafetería.", "opciones": [
          {"ru": "Я в кафе́.", "fonetica": "ia f ka-FE", "correcta": true, "porque": "¡Bien! кафе́ es el lugar y no cambia."},
          {"ru": "Я в ко́фе.", "fonetica": "ia f KO-fie", "correcta": false, "porque": "ко́фе es la bebida (café); el lugar es кафе́."},
          {"ru": "Я кафе́.", "fonetica": "ia ka-FE", "correcta": false, "porque": "Falta в: я в кафе́ = estoy en la cafetería. «Я кафе́» diría «yo soy una cafetería»."}
        ]},
        {"de": "Ле́на", "ru": "Там ко́фе?", "fonetica": "tam KO-fie", "es": "¿Hay café allá?"},
        {"de": "yo", "ru": "Да, там ко́фе.", "fonetica": "da, tam KO-fie", "es": "Sí, allá hay café.", "opciones": [
          {"ru": "Да, там ко́фе.", "fonetica": "da, tam KO-fie", "correcta": true, "porque": "¡Eso! ко́фе es la bebida."},
          {"ru": "Да, там кафе́.", "fonetica": "da, tam ka-FE", "correcta": false, "porque": "Ella pregunta por la bebida: ко́фе; кафе́ es el lugar."},
          {"ru": "Нет, там ко́фе.", "fonetica": "niet, tam KO-fie", "correcta": false, "porque": "Dices нет pero confirmas que hay café: да."}
        ]},
        {"de": "Ле́на", "ru": "Хорошо́!", "fonetica": "ja-ra-SHO", "es": "¡Bien!"}
      ]
    },
    {
      "id": "falsos-amigos-d2",
      "extra": true,
      "titulo": "Roma y Román",
      "mensajes": [
        {"de": "Ле́на", "ru": "Э́то Ро́ма?", "fonetica": "E-ta RO-ma", "es": "¿Este es Román?"},
        {"de": "yo", "ru": "Нет, э́то Рим.", "fonetica": "niet, E-ta rim", "es": "No, esta es Roma (la ciudad).", "opciones": [
          {"ru": "Нет, э́то Рим.", "fonetica": "niet, E-ta rim", "correcta": true, "porque": "¡Bien! La ciudad se llama Рим."},
          {"ru": "Да, э́то Ро́ма.", "fonetica": "da, E-ta RO-ma", "correcta": false, "porque": "Ро́ма es Román (un nombre); la ciudad es Рим."},
          {"ru": "Нет, э́то не Рим.", "fonetica": "niet, E-ta nie rim", "correcta": false, "porque": "Quieres decir que sí es la ciudad: э́то Рим."}
        ]},
        {"de": "Ле́на", "ru": "А э́то кто?", "fonetica": "a E-ta kto", "es": "¿Y quién es este?"},
        {"de": "yo", "ru": "Э́то Ро́ма, мой друг.", "fonetica": "E-ta RO-ma, moi drug", "es": "Es Román, mi amigo.", "opciones": [
          {"ru": "Э́то Ро́ма, мой друг.", "fonetica": "E-ta RO-ma, moi drug", "correcta": true, "porque": "¡Perfecto! Ро́ма es el nombre del amigo."},
          {"ru": "Э́то Рим, мой друг.", "fonetica": "E-ta rim, moi drug", "correcta": false, "porque": "Рим es la ciudad; el amigo se llama Ро́ма."},
          {"ru": "Э́то Ро́ма, моя́ друг.", "fonetica": "E-ta RO-ma, ma-IA drug", "correcta": false, "porque": "друг es masculino: мой друг."}
        ]},
        {"de": "Ле́на", "ru": "О́чень прия́тно!", "fonetica": "O-chin' pri-IAT-na", "es": "¡Mucho gusto!"}
      ]
    },
    {
      "id": "falsos-amigos-d3",
      "extra": true,
      "titulo": "¿Los conoces?",
      "mensajes": [
        {"de": "Све́та", "ru": "Вот Ро́ма и Ми́ша. Э́то твои́ друзья́?", "fonetica": "vot RO-ma i MI-sha. E-ta tva-I druz'-IA", "es": "Ahí están Román y Misha. ¿Son tus amigos?"},
        {"de": "yo", "ru": "Да, я их хорошо́ зна́ю.", "fonetica": "da, ia ij ja-ra-SHO ZNA-iu", "es": "Sí, los conozco bien.", "opciones": [
          {"ru": "Да, я их хорошо́ зна́ю.", "fonetica": "da, ia ij ja-ra-SHO ZNA-iu", "correcta": true, "porque": "¡Bien! Aquí их = los (a ellos): я их зна́ю."},
          {"ru": "Да, я они́ хорошо́ зна́ю.", "fonetica": "da, ia a-NI ja-ra-SHO ZNA-iu", "correcta": false, "porque": "они́ es «ellos» cuando ellos hacen algo. «Los conozco» se dice я их зна́ю."},
          {"ru": "Да, я его́ хорошо́ зна́ю.", "fonetica": "da, ia ie-VO ja-ra-SHO ZNA-iu", "correcta": false, "porque": "его́ es «lo» (a él, uno solo). Son dos amigos: их."}
        ]},
        {"de": "Све́та", "ru": "А куда́ идёт Ро́ма?", "fonetica": "a ku-DA i-DIOT RO-ma", "es": "¿Y a dónde va Román?"},
        {"de": "yo", "ru": "Он идёт в класс.", "fonetica": "on i-DIOT f klas", "es": "Va al salón.", "opciones": [
          {"ru": "Он идёт в класс.", "fonetica": "on i-DIOT f klas", "correcta": true, "porque": "¡Eso! класс es el salón de clases: в класс."},
          {"ru": "Она́ идёт в класс.", "fonetica": "a-NA i-DIOT f klas", "correcta": false, "porque": "Ро́ма es un chico: он."},
          {"ru": "Он идёт там.", "fonetica": "on i-DIOT tam", "correcta": false, "porque": "там contesta где (dónde está). Para куда́ dices a dónde va: в класс."}
        ]},
        {"de": "Све́та", "ru": "Почему́ он говори́т так серди́то?", "fonetica": "pa-chi-MU on ga-va-RIT tak sier-DI-ta", "es": "¿Por qué habla con tanto enojo?"},
        {"de": "yo", "ru": "Потому́ что сейча́с ра́но.", "fonetica": "pa-ta-MU shta sie-CHAS RA-na", "es": "Porque ahora es temprano.", "opciones": [
          {"ru": "Потому́ что сейча́с ра́но.", "fonetica": "pa-ta-MU shta sie-CHAS RA-na", "correcta": true, "porque": "¡Muy bien! ра́но = temprano. Y серди́то no es «cerdito», es «con enojo»."},
          {"ru": "Потому́ что сейча́с ра́на.", "fonetica": "pa-ta-MU shta sie-CHAS RA-na", "correcta": false, "porque": "ра́на y ра́но suenan igual; solo cambia la letra final. ра́на es una herida; temprano es ра́но."},
          {"ru": "Почему́ сейча́с ра́но.", "fonetica": "pa-chi-MU sie-CHAS RA-na", "correcta": false, "porque": "почему́ es la pregunta «por qué»; para contestar se usa потому́ что."}
        ]},
        {"de": "Све́та", "ru": "Да, о́чень ра́но!", "fonetica": "da, O-chin' RA-na", "es": "¡Sí, muy temprano!"}
      ]
    }
  ],
