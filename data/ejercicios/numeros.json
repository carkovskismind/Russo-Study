    {
      "id": "numeros-d1",
      "titulo": "Mi número",
      "mensajes": [
        {"de": "Ле́на", "ru": "Како́й твой но́мер?", "fonetica": "ka-KOI tvoi NO-mier", "es": "¿Cuál es tu número?"},
        {"de": "yo", "ru": "Мой но́мер во́семь пять три.", "fonetica": "moi NO-mier VO-siem' piat' tri", "es": "Mi número es ocho, cinco, tres.", "opciones": [
          {"ru": "Мой но́мер во́семь пять три.", "fonetica": "moi NO-mier VO-siem' piat' tri", "correcta": true, "porque": "¡Bien! Los dígitos van en el orden en que se dicen."},
          {"ru": "Мой но́мер во́семь три пять.", "fonetica": "moi NO-mier VO-siem' tri piat'", "correcta": false, "porque": "Los dígitos van en el mismo orden: 8-5-3, no 8-3-5."},
          {"ru": "Моя́ но́мер во́семь пять три.", "fonetica": "ma-IA NO-mier VO-siem' piat' tri", "correcta": false, "porque": "но́мер es masculino: мой но́мер."}
        ]},
        {"de": "Ле́на", "ru": "Во́семь пять три? Да?", "fonetica": "VO-siem' piat' tri? da", "es": "¿Ocho, cinco, tres? ¿Sí?"},
        {"de": "yo", "ru": "Да, во́семь пять три.", "fonetica": "da, VO-siem' piat' tri", "es": "Sí, ocho, cinco, tres.", "opciones": [
          {"ru": "Да, во́семь пять три.", "fonetica": "da, VO-siem' piat' tri", "correcta": true, "porque": "¡Eso! Confirmas con да."},
          {"ru": "Нет, во́семь пять три.", "fonetica": "niet, VO-siem' piat' tri", "correcta": false, "porque": "Repites el mismo número, así que confirmas: да."},
          {"ru": "Да, шесть пять три.", "fonetica": "da, shest' piat' tri", "correcta": false, "porque": "Repites los mismos números: во́семь, no шесть."}
        ]},
        {"de": "Ле́на", "ru": "Спаси́бо!", "fonetica": "spa-SI-ba", "es": "¡Gracias!"}
      ]
    },
    {
      "id": "numeros-d2",
      "titulo": "¿Cuántos?",
      "mensajes": [
        {"de": "Ле́на", "ru": "Ско́лько вас?", "fonetica": "SKOL'-ka vas", "es": "¿Cuántos son ustedes?"},
        {"de": "yo", "ru": "Нас че́тверо.", "fonetica": "nas CHIET-vie-ra", "es": "Somos cuatro.", "opciones": [
          {"ru": "Нас че́тверо.", "fonetica": "nas CHIET-vie-ra", "correcta": true, "porque": "¡Bien! Para decir cuántos son se usa нас."},
          {"ru": "Мы четы́ре.", "fonetica": "my chi-TY-rie", "correcta": false, "porque": "Para decir cuántos son se usa нас: нас четы́ре."},
          {"ru": "Нас два.", "fonetica": "nas dva", "correcta": false, "porque": "два es 2; son 4: четы́ре."}
        ]},
        {"de": "Ле́на", "ru": "А ско́лько там?", "fonetica": "a SKOL'-ka tam", "es": "¿Y cuántos hay allá?"},
        {"de": "yo", "ru": "Там две́сти.", "fonetica": "tam DVIES-ti", "es": "Allá hay doscientos.", "opciones": [
          {"ru": "Там две́сти.", "fonetica": "tam DVIES-ti", "correcta": true, "porque": "¡Exacto! 200 = две́сти."},
          {"ru": "Там два́дцать.", "fonetica": "tam DVA-tsat'", "correcta": false, "porque": "два́дцать es 20; doscientos es две́сти."},
          {"ru": "Там три́ста.", "fonetica": "tam TRI-sta", "correcta": false, "porque": "три́ста es 300; son 200: две́сти."}
        ]},
        {"de": "Ле́на", "ru": "Хорошо́!", "fonetica": "ja-ra-SHO", "es": "¡Bien!"}
      ]
    },
    {
      "id": "numeros-d3",
      "titulo": "Los cuartos del hotel",
      "mensajes": [
        {"de": "Ле́на", "ru": "Твой но́мер — пятьдеся́т?", "fonetica": "tvoi NO-mier — pit'-die-SIAT?", "es": "¿Tu cuarto es el cincuenta?"},
        {"de": "yo", "ru": "Нет, пятьсо́т.", "fonetica": "niet, pit'-SOT", "es": "No, el quinientos.", "opciones": [
          {"ru": "Нет, пятьсо́т.", "fonetica": "niet, pit'-SOT", "correcta": true, "porque": "¡Bien! Las centenas del 500 al 900 terminan en -сот: пятьсо́т."},
          {"ru": "Нет, пятьдеся́т.", "fonetica": "niet, pit'-die-SIAT", "correcta": false, "porque": "пятьдеся́т es 50, lo que preguntó Ле́на. Tu cuarto es el 500: пятьсо́т."},
          {"ru": "Нет, пятна́дцать.", "fonetica": "niet, pit-NA-tsat'", "correcta": false, "porque": "пятна́дцать es 15. Para 500 se dice пятьсо́т."}
        ]},
        {"de": "Ле́на", "ru": "А мой — восемьсо́т?", "fonetica": "a moi — va-siem'-SOT?", "es": "¿Y el mío es el ochocientos?"},
        {"de": "yo", "ru": "Нет, твой — девятьсо́т.", "fonetica": "niet, tvoi — die-vit'-SOT", "es": "No, el tuyo es el novecientos.", "opciones": [
          {"ru": "Нет, твой — девятьсо́т.", "fonetica": "niet, tvoi — die-vit'-SOT", "correcta": true, "porque": "¡Eso! 900 = девятьсо́т: también termina en -сот."},
          {"ru": "Нет, твой — девяно́сто.", "fonetica": "niet, tvoi — die-vi-NOS-ta", "correcta": false, "porque": "девяно́сто es 90. Para 900 se dice девятьсо́т."},
          {"ru": "Нет, твой — девятна́дцать.", "fonetica": "niet, tvoi — die-vit-NA-tsat'", "correcta": false, "porque": "девятна́дцать es 19. Para 900 se dice девятьсо́т."}
        ]},
        {"de": "Ле́на", "ru": "Спаси́бо!", "fonetica": "spa-SI-ba", "es": "¡Gracias!"}
      ]
