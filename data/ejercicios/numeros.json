        ]},
        {"de": "Ми́ша", "ru": "Со́рок два — чётный но́мер. А со́рок пять?", "fonetica": "SO-rak dva — CHIOT-nyi NO-mier. a SO-rak piat'?", "es": "Cuarenta y dos es un número par. ¿Y cuarenta y cinco?"},
        {"de": "yo", "ru": "Нечётный.", "fonetica": "nie-CHIOT-nyi", "es": "Impar.", "opciones": [
          {"ru": "Нечётный.", "fonetica": "nie-CHIOT-nyi", "correcta": true, "porque": "¡Eso! 45 termina en 5, así que es impar: нечётный."},
          {"ru": "Чётный.", "fonetica": "CHIOT-nyi", "correcta": false, "porque": "чётный es «par»; 45 es impar: нечётный."},
          {"ru": "Пя́тый.", "fonetica": "PIA-tyi", "correcta": false, "porque": "пя́тый es «quinto». Aquí la pregunta es si es par o impar: нечётный."}
        ]},
        {"de": "Ми́ша", "ru": "Хорошо́!", "fonetica": "ja-ra-SHO", "es": "¡Bien!"}
      ]
