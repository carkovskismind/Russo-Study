          {"ru": "Моя́ соба́ка бе́лый.", "fonetica": "ma-IA sa-BA-ka BIE-lyi", "correcta": false, "porque": "соба́ка es femenina: бе́лая."},
          {"ru": "Мой соба́ка бе́лая.", "fonetica": "moi sa-BA-ka BIE-la-ia", "correcta": false, "porque": "соба́ка es femenina: моя́."}
