    {"id": "estudio-ruso", "idea": "Di que estudias el idioma ruso.", "fichas": ["Я", "изуча́ю", "ру́сский", "язы́к"], "validas": ["Я изуча́ю ру́сский язы́к", "Ру́сский язы́к я изуча́ю"], "texto": "Я изуча́ю ру́сский язы́к.", "fonetica": "ia i-zu-CHA-iu RUS-kii ia-ZYK", "es": "Estudio el idioma ruso.", "opciones": ["Estudio el idioma ruso.", "Enseño el idioma ruso.", "Estudiaba ruso.", "Estudias el idioma ruso."], "distractores": ["изуча́ешь", "литерату́ра"], "pista": "Con «я» el verbo termina en -ю.", "diccionario": [{"ficha": "Я", "forma": "я", "es": "yo", "fonetica": "ia", "porque": ""}, {"ficha": "изуча́ю", "forma": "изуча́ть", "es": "estudiar (analizando un tema)", "fonetica": "i-zu-CHA-iu", "porque": "Presente con я: изуча'ть → изуча'ю."}, {"ficha": "ру́сский", "forma": "ру́сский", "es": "ruso", "fonetica": "RUS-kii", "porque": ""}, {"ficha": "язы́к", "forma": "язы́к", "es": "idioma, lengua", "fonetica": "ia-ZYK", "porque": ""}, {"ficha": "изуча́ешь", "forma": "изуча́ть", "es": "estudiar (analizando un tema)", "fonetica": "i-zu-CHA-iesh", "porque": "Presente con ты: изуча'ть → изуча'ешь."}, {"ficha": "литерату́ра", "forma": "литерату́ра", "es": "literatura", "fonetica": "li-ti-ra-TU-ra", "porque": ""}], "bloques": [["Я", "изуча́ю"], ["ру́сский", "язы́к"]], "fijo": false, "errores": [{"tipo": "bloque", "fichas": ["Я", "изуча́ю"], "explica": "Я и изуча́ю van juntas: изуча́ю es la forma de я."}, {"tipo": "bloque", "fichas": ["ру́сский", "язы́к"], "explica": "ру́сский и язы́к van juntos: ру́сский язы́к = idioma ruso."}, {"tipo": "distractor", "ficha": "изуча́ешь", "explica": "изуча́ешь es la forma de ты; con я es изуча́ю."}, {"tipo": "distractor", "ficha": "литерату́ра", "explica": "литерату́ра es «literatura»; la idea dice idioma ruso."}]},
    {"id": "correcto-incorrecto", "idea": "Di: esto es correcto y esto es incorrecto.", "fichas": ["Э́то", "пра́вильно", "а", "э́то", "непра́вильно"], "validas": ["Э́то пра́вильно а э́то непра́вильно"], "texto": "Э́то пра́вильно, а э́то непра́вильно.", "fonetica": "E-ta PRA-vil'-na a E-ta ni-PRA-vil'-na", "es": "Esto es correcto y esto incorrecto.", "opciones": ["Esto es incorrecto y esto correcto.", "Esto es correcto y esto incorrecto.", "Esto es correcto y esto una pregunta.", "Esto era correcto y esto incorrecto."], "distractores": ["отве́т", "вопро́с"], "pista": "Se añade «не» pegado a la palabra.", "diccionario": [{"ficha": "Э́то", "forma": "э́то", "es": "esto, esto es", "fonetica": "E-ta", "porque": ""}, {"ficha": "пра́вильно", "forma": "пра́вильно", "es": "correcto", "fonetica": "PRA-vil'-na", "porque": ""}, {"ficha": "а", "forma": "а", "es": "y, en cambio", "fonetica": "a", "porque": ""}, {"ficha": "э́то", "forma": "э́то", "es": "esto, esto es", "fonetica": "E-ta", "porque": ""}, {"ficha": "непра́вильно", "forma": "непра́вильно", "es": "incorrecto", "fonetica": "ni-PRA-vil'-na", "porque": ""}, {"ficha": "отве́т", "forma": "отве́т", "es": "respuesta", "fonetica": "at-VIET", "porque": ""}, {"ficha": "вопро́с", "forma": "вопро́с", "es": "pregunta", "fonetica": "vap-ROS", "porque": ""}], "bloques": [["Э́то", "пра́вильно"], ["а"], ["э́то", "непра́вильно"]], "fijo": true, "errores": [{"tipo": "bloque", "fichas": ["Э́то", "пра́вильно"], "explica": "Э́то и пра́вильно van juntas: э́то пра́вильно = esto es correcto."}, {"tipo": "bloque", "fichas": ["э́то", "непра́вильно"], "explica": "э́то и непра́вильно van juntas: э́то непра́вильно = esto es incorrecto."}, {"tipo": "orden", "explica": "Primero lo correcto (э́то пра́вильно), luego а y lo incorrecto (э́то непра́вильно)."}, {"tipo": "distractor", "ficha": "отве́т", "explica": "отве́т es «respuesta»; aquí se necesita «correcto»: пра́вильно."}, {"tipo": "distractor", "ficha": "вопро́с", "explica": "вопро́с es «pregunta»;