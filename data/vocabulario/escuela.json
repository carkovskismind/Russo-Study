    {"id": "pregunta-respuesta", "idea": "Di: aquí está mi pregunta y aquí tu respuesta.", "fichas": ["Вот", "мой", "вопро́с", "а", "вот", "твой", "отве́т"], "validas": ["Вот мой вопро́с а вот твой отве́т", "Вот твой отве́т а вот мой вопро́с"], "texto": "Вот мой вопро́с, а вот твой отве́т.", "fonetica": "vot moi vap-ROS a vot tvoi at-VIET", "es": "Aquí está mi pregunta y aquí tu respuesta.", "opciones": ["Aquí está tu pregunta y aquí mi respuesta.", "Aquí está mi pregunta y aquí mi tarea.", "Aquí está mi pregunta y aquí tu respuesta.", "Aquí estaba mi pregunta y tu respuesta."], "distractores": ["зада́ние", "сло́во"], "pista": "Los dos sustantivos son masculinos.", "diccionario": [{"ficha": "Вот", "forma": "вот", "es": "aquí está", "fonetica": "vot", "porque": ""}, {"ficha": "мой", "forma": "мой", "es": "mi", "fonetica": "moi", "porque": "Masculino: мой."}, {"ficha": "вопро́с", "forma": "вопро́с", "es": "pregunta", "fonetica": "vap-ROS", "porque": ""}, {"ficha": "а", "forma": "а", "es": "y, en cambio", "fonetica": "a", "porque": ""}, {"ficha": "вот", "forma": "вот", "es": "aquí está", "fonetica": "vot", "porque": ""}, {"ficha": "твой", "forma": "твой", "es": "tu", "fonetica": "tvoi", "porque": "Masculino: твой."}, {"ficha": "отве́т", "forma": "отве́т", "es": "respuesta", "fonetica": "at-VIET", "porque": ""}, {"ficha": "зада́ние", "forma": "зада́ние", "es": "tarea, ejercicio", "fonetica": "za-DA-ni-ie", "porque": ""}, {"ficha": "сло́во", "forma": "сло́во", "es": "palabra", "fonetica": "SLO-va", "porque": ""}], "bloques": [["Вот", "мой", "вопро́с"], ["а"], ["вот", "твой", "отве́т"]], "fijo": false, "errores": [{"tipo": "bloque", "fichas": ["Вот", "мой", "вопро́с"], "explica": "Вот, мой y вопро́с van juntos: мой va con вопро́с (masculino)."}, {"tipo": "bloque", "fichas": ["вот", "твой", "отве́т"], "explica": "вот, твой y отве́т van juntos: твой va con отве́т (masculino)."}, {"tipo": "distractor", "ficha": "зада́ние", "explica": "зада́ние es «tarea»; la idea dice pregunta y respuesta."}, {"tipo": "distractor", "ficha": "сло́во", "explica": "сло́во es «palabra»; la idea dice pregunta y respuesta."}]},
    {"id": "dos-mas-tres", "idea": "Di: dos más tres es igual a cinco.", "fichas": ["Два", "плюс", "три", "равно́", "пять"], "validas": ["Два плюс три равно́ пять", "Три плюс два равно́ пять"], "texto": "Два плюс три равно́ пять.", "fonetica": "dva plius tri rav-NO piat'", "es": "Dos más tres es igual a cinco.", "opciones": ["Dos menos tres es igual a cinco.", "Dos más tres es igual a seis.", "Dos por tres es igual a cinco.", "Dos más tres es igual a cinco."], "distractores": ["ми́нус", "шесть"], "pista": "Suma primero y da el resultado después de «равно'».", "diccionario": [{"ficha": "Два", "forma": "два", "es": "dos", "fonetica": "dva", "porque": ""}, {"ficha": "плюс", "forma": "плюс", "es": "más (+)", "fonetica": "plius", "porque": ""}, {"ficha": "три", "forma": "три", "es": "tres", "fonetica": "tri", "porque": ""}, {"ficha": "равно́", "forma": "равно́", "es": "igual a (=)", "fonetica": "rav-NO", "porque": ""}, {"ficha": "пять", "forma": "пять", "es": "cinco", "fonetica": "piat'", "porque": ""}, {"ficha": "ми́нус", "forma": "ми́нус", "es": "menos (−)", "fonetica": "MI-nus", "porque": ""}, {"ficha": "шесть", "forma": "шесть", "es": "seis", "fonetica": "shest'", "porque": ""}], "bloques": [["Два", "плюс", "три"], ["равно́", "пять"]], "fijo": false, "errores": [{"tipo": "bloque", "fichas": ["Два", "плюс", "три"], "explica": "Два плюс три van juntos: es la suma."}, {"tipo": "bloque", "fichas": ["равно́", "пять"], "explica": "равно́ и пять van juntos: равно́ пять = es igual a cinco."}, {"tipo": "distractor", "ficha": "ми́нус", "explica": "ми́нус es «menos»; la idea es una suma: плюс."}, {"tipo": "distractor", "ficha": "шесть", "explica": "шесть es «seis»; dos más tres es пять."}]},
    {"id": "verbo-no-sustantivo", "idea": "Di que el verbo no es un sustantivo.", "fichas": ["Глаго́л", "э́то", "не", "существи́тельное"], "validas": ["Глаго́л э́то не существи́тельное"], "texto": "Глаго́л — э́то не существи́тельное.", "fonetica": "gla-GOL E-ta ni su-shchist-vi-TIEL'-na-ie", "es": "El verbo no es un sustantivo.", "opciones": ["El verbo no es un sustantivo.", "El sustantivo no es un verbo.", "El verbo es un adjetivo.", "El adverbio no es un sustantivo."], "distractores": ["прилага́тельное", "наре́чие"], "pista": "Rayita entre el tema y su definición.", "diccionario": [{"ficha": "Глаго́л", "forma": "глаго́л", "es": "verbo", "fonetica": "gla-GOL", "porque": ""}, {"ficha": "э́то", "forma": "э́то", "es": "esto, esto es", "fonetica": "E-ta", "porque": ""}, {"ficha": "не", "forma": "не", "es": "no (niega la palabra siguiente)", "fonetica": "ni", "porque": ""}, {"ficha": "существи́тельное", "forma": "существи́тельное", "es": "sustantivo", "fonetica": "su-shchist-vi-TIEL'-na-ie", "porque": ""}, {"ficha": "прилага́тельное", "forma": "прилага́тельное", "es": "adjetivo", "fonetica": "pri-la-GA-tiel'-na-ie", "porque": ""}, {"ficha": "наре́чие", "forma": "наре́чие", "es": "adverbio", "fonetica": "na-RIE-chi-ie", "porque": ""}], "bloques": [["Глаго́л"], ["э́то", "не", "существи́тельное"]], "fijo": true, "errores": [{"tipo": "bloque", "fichas": ["э́то", "не", "существи́тельное"], "explica": "э́то, не y существи́тельное van juntas: не va justo antes de существи́тельное."}, {"tipo": "orden", "explica": "Primero de qué hablas (глаго́л) y luego lo que no es (э́то не существи́тельное)."}, {"tipo": "distractor", "ficha": "прилага́тельное", "explica": "прилага́тельное es «adjetivo»; la idea dice sustantivo."}, {"tipo": "distractor", "ficha": "наре́чие", "explica": "наре́чие es «adverbio»; la idea dice sustantivo."}]},
    {"id": "que-palabra", "idea": "Pregunta qué palabra es esta.", "fichas": ["Како́е", "э́то", "сло́во"], "validas": ["Како́е э́то сло́во", "Э́то како́е сло́во"], "texto": "Како́е э́то сло́во?", "fonetica": "ka-KO-ie E-ta SLO-va", "es": "¿Qué palabra es esta?", "opciones": ["¿Cuál es la respuesta?", "¿Qué palabra es esta?", "¿Qué palabra era?", "¿Qué pregunta es esta?"], "distractores": ["како́й", "вопро́с"], "pista": "«Сло'во» es neutro: «како'е» concuerda.", "diccionario": [{"ficha": "Како́е", "forma": "како́й", "es": "qué, cuál, cómo es", "fonetica": "ka-KO-ie", "porque": "Concuerda con сло'во (neutro): како'й → како'е."}, {"ficha": "э́то", "forma": "э́то", "es": "esto, esto es", "fonetica": "E-ta", "porque": ""}, {"ficha": "сло́во", "forma": "сло́во", "es": "palabra", "fonetica": "SLO-va", "porque": ""}, {"ficha": "како́й", "forma": "како́й", "es": "qué, cuál, cómo es", "fonetica": "ka-KOI", "porque": "Masculino: како'й."}, {"ficha": "вопро́с", "forma": "вопро́с", "es": "pregunta", "fonetica": "vap-ROS", "porque": ""}], "bloques": [["Како́е", "э́то", "сло́во"]], "fijo": false, "errores": [{"tipo": "bloque", "fichas": ["Како́е", "э́то", "сло́во"], "explica": "Како́е э́то сло́во va junto: así se pregunta «¿qué palabra es esta?»."}, {"tipo": "distractor", "ficha": "како́й", "explica": "како́й es masculino; сло́во es neutro: како́е."}, {"tipo": "distractor", "ficha": "вопро́с", "explica": "вопро́с es «pregunta»; la idea pregunta por una palabra."}]}
