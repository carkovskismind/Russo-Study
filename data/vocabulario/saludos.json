  "frases": [
    {"id": "me-llamo", "idea": "Di tu nombre: «Me llamo Carol».", "fichas": ["Меня́", "зову́т", "Ка́рол"], "validas": ["Меня́ зову́т Ка́рол"], "texto": "Меня́ зову́т Ка́рол.", "fonetica": "mi-NIA za-VUT ka-ROL", "es": "Me llamo Carol.", "opciones": ["Me llamo Carol.", "Se llama Carol.", "Nos llamamos Carol.", "Me llamo Karina."], "distractores": ["нас", "тебя́"], "pista": "Literalmente: «a mí me llaman…».", "diccionario": [{"ficha": "Меня́", "forma": "я", "es": "yo (a mí)", "fonetica": "mi-NIA", "porque": "Con «зову'т» y «у» se usa la forma меня': я → меня'."}, {"ficha": "зову́т", "forma": "звать", "es": "llamar (por nombre)", "fonetica": "za-VUT", "porque": "Presente con ellos/«se»: звать → зову'т (me llaman)."}, {"ficha": "Ка́рол", "forma": "Ка́рол", "es": "Carol (nombre)", "fonetica": "ka-ROL", "porque": ""}, {"ficha": "нас", "forma": "мы", "es": "nosotros (a nosotros)", "fonetica": "nas", "porque": "Cambia como мы → нас."}, {"ficha": "тебя́", "forma": "ты", "es": "tú (a ti)", "fonetica": "ti-BIA", "porque": "Cambia como ты → тебя'."}], "bloques": [["Меня́", "зову́т"], ["Ка́рол"]], "fijo": true, "errores": [{"tipo": "bloque", "fichas": ["Меня́", "зову́т"], "explica": "Меня́ зову́т van juntas: así se dice «me llamo» (literal: me llaman)."}, {"tipo": "orden", "explica": "Primero меня́ зову́т y al final el nombre."}, {"tipo": "distractor", "ficha": "нас", "explica": "нас es «a nosotros»; para «me» se usa меня́."}, {"tipo": "distractor", "ficha": "тебя́", "explica": "тебя́ es «a ti»; para decir tu nombre se usa меня́."}]},
    {"id": "como-te-llamas", "idea": "Pregunta a un amigo cómo se llama.", "fichas": ["Как", "тебя́", "зову́т"], "validas": ["Как тебя́ зову́т"], "texto": "Как тебя́ зову́т?", "fonetica": "kak ti-BIA za-VUT", "es": "¿Cómo te llamas?", "opciones": ["¿Cómo se llama él?", "¿Cómo te llamas?", "¿Cómo se llama usted?", "¿Cómo estás?"], "distractores": ["вас", "его́"], "pista": "Con un amigo usas «tú»: a ti te llaman…", "diccionario": [{"ficha": "Как", "forma": "как", "es": "cómo", "fonetica": "kak", "porque": ""}, {"ficha": "тебя́", "forma": "ты", "es": "tú (a ti)", "fonetica": "ti-BIA", "porque": "Cambia como ты → тебя'."}, {"ficha": "зову́т", "forma": "звать", "es": "llamar (por nombre)", "fonetica": "za-VUT", "porque": "Presente con ellos/«se»: звать → зову'т (me llaman)."}, {"ficha": "вас", "forma": "вы", "es": "ustedes, usted (a usted)", "fonetica": "vas", "porque": "Cambia como вы → вас."}, {"ficha": "его́", "forma": "он", "es": "él (a él), su (de él)", "fonetica": "i-VO", "porque": "Cambia como он → его'."}], "bloques": [["Как", "тебя́", "зову́т"]], "fijo": true, "errores": [{"tipo": "bloque", "fichas": ["Как", "тебя́", "зову́т"], "explica": "Как тебя́ зову́т van juntas: así se pregunta el nombre."}, {"tipo": "orden", "explica": "Como pregunta, empieza con как y termina con зову́т."}, {"tipo": "distractor", "ficha": "вас", "explica": "вас es «a usted»; con un amigo se usa «tú»: тебя́."}, {"tipo": "distractor", "ficha": "его́", "explica": "его́ es «a él»; preguntas a tu amigo: тебя́."}]},
    {"id": "hola-como-estas", "idea": "Saluda y pregunta cómo está.", "fichas": ["Приве́т", "как", "дела́"], "validas": ["Приве́т как дела́"], "texto": "Приве́т, как дела́?", "fonetica": "pri-VIET kak di-LA", "es": "Hola, ¿cómo estás?", "opciones": ["Hola, ¿cómo te llamas?", "Adiós, ¿cómo estás?", "Hola, ¿cómo estás?", "Buenos días, ¿cómo estás?"], "distractores": ["пока́", "до́брый"], "pista": "Un saludo informal y luego la pregunta.", "diccionario": [{"ficha": "Приве́т", "forma": "приве́т", "es": "¡hola!", "fonetica": "pri-VIET", "porque": ""}, {"ficha": "как", "forma": "как", "es": "cómo", "fonetica": "kak", "porque": ""}, {"ficha": "дела́", "forma": "дела́", "es": "asuntos, cosas (как дела' = ¿cómo estás?)", "fonetica": "di-LA", "porque": "Forma plural en la frase hecha «как дела'?»."}, {"ficha": "пока́", "forma": "пока́", "es": "adiós, bye", "fonetica": "pa-KA", "porque": ""}, {"ficha": "до́брый", "forma": "до́брый", "es": "bueno, amable", "fonetica": "DO-bryi", "porque": ""}], "bloques": [["Приве́т"], ["как", "дела́"]], "fijo": true, "errores": [{"tipo": "bloque", "fichas": ["как", "дела́"], "explica": "как дела́ van juntas: así se pregunta «¿cómo estás?»."}, {"tipo": "orden", "explica": "Primero el saludo (приве́т) y luego la pregunta (как дела́)."}, {"tipo": "distractor", "ficha": "пока́", "explica": "пока́ es «adiós»; aquí estás saludando."}, {"tipo": "distractor", "ficha": "до́брый", "explica": "до́брый va con день o ве́чер; solo no es un saludo."}]},
    {"id": "gracias-manana", "idea": "Da las gracias y despídete hasta mañana.", "fichas": ["Большо́е", "спаси́бо", "до", "за́втра"], "validas": ["Большо́е спаси́бо до за́втра", "До за́втра большо́е спаси́бо"], "texto": "Большо́е спаси́бо, до за́втра!", "fonetica": "bal-SHO-ie spa-SI-ba da ZAF-tra", "es": "Muchas gracias, hasta mañana.", "opciones": ["Gracias, hasta luego.", "Muchas gracias, buenas noches.", "Muchas gracias, nos vemos pronto.", "Muchas gracias, hasta mañana."], "distractores": ["до свида́ния", "пожа́луйста"], "pista": "Dos frases hechas seguidas.", "diccionario": [{"ficha": "Большо́е", "forma": "большо́й", "es": "grande", "fonetica": "bal-SHO-ie", "porque": "Concuerda con спаси'бо (neutro): большо'й → большо'е."}, {"ficha": "спаси́бо", "forma": "спаси́бо", "es": "gracias", "fonetica": "spa-SI-ba", "porque": ""}, {"ficha": "до", "forma": "до", "es": "hasta", "fonetica": "da", "porque": ""}, {"ficha": "за́втра", "forma": "за́втра", "es": "mañana", "fonetica": "ZAF-tra", "porque": ""}, {"ficha": "до свида́ния", "forma": "до свида́ния", "es": "hasta luego, adiós", "fonetica": "da svi-DA-nia", "porque": ""}, {"ficha": "пожа́луйста", "forma": "пожа́луйста", "es": "por favor, de nada", "fonetica": "pa-ZHAL-sta", "porque": ""}], "bloques": [["Большо́е", "спаси́бо"], ["до", "за́втра"]], "fijo": false, "errores": [{"tipo": "bloque", "fichas": ["Большо́е", "спаси́бо"], "explica": "Большо́е спаси́бо van juntas: большо́е va con спаси́бо."}, {"tipo": "bloque", "fichas": ["до", "за́втра"], "explica": "до за́втра van juntas: до за́втра = hasta mañana."}, {"tipo": "distractor", "ficha": "до свида́ния", "explica": "до свида́ния es «adiós»; la idea dice «hasta mañana»: до за́втра."}, {"tipo": "distractor", "ficha": "пожа́луйста", "explica": "пожа́луйста es «por favor / de nada»; la idea dice gracias: спаси́бо."}]},
    {"id": "disculpe-nombre", "idea": "Pregunta a una persona mayor cómo se llama, con cortesía.", "fichas": ["Извини́те", "как", "вас", "зову́т"], "validas": ["Извини́те как вас зову́т", "Как вас зову́т извини́те"], "texto": "Извини́те, как вас зову́т?", "fonetica": "iz-vi-NI-tie kak vas za-VUT", "es": "Disculpe, ¿cómo se llama usted?", "opciones": ["Disculpe, ¿cómo se llama usted?", "Disculpa, ¿cómo te llamas?", "Disculpe, ¿cómo se llama él?", "Perdón, ¿cómo está usted?"], "distractores": ["извини́", "тебя́"], "pista": "Con «usted» se usa «вас».", "diccionario": [{"ficha": "Извини́те", "forma": "извини́ть", "es": "disculpar", "fonetica": "iz-vi-NI-tie", "porque": "Forma de cortesía (usted / ustedes): извини'ть → извини'те."}, {"ficha": "как", "forma": "как", "es": "cómo", "fonetica": "kak", "porque": ""}, {"ficha": "вас", "forma": "вы", "es": "ustedes, usted (a usted)", "fonetica": "vas", "porque": "Cambia como вы → вас."}, {"ficha": "зову́т", "forma": "звать", "es": "llamar (por nombre)", "fonetica": "za-VUT", "porque": "Presente con ellos/«se»: звать → зову'т (me llaman)."}, {"ficha": "извини́", "forma": "извини́ть", "es": "disculpar (de tú)", "fonetica": "iz-vi-NI", "porque": "Forma de «tú»: извини'ть → извини'."}, {"ficha": "тебя́", "forma": "ты", "es": "tú (a ti)", "fonetica": "ti-BIA", "porque": "Cambia como ты → тебя'."}], "bloques": [["Извини́те"], ["как", "вас", "зову́т"]], "fijo": false, "errores": [{"tipo": "bloque", "fichas": ["как", "вас", "зову́т"], "explica": "как, вас y зову́т van juntas: как вас зову́т = ¿cómo se llama usted?"}, {"tipo": "distractor", "ficha": "извини́", "explica": "извини́ es para «tú»; con «usted» se dice извини́те."}, {"tipo": "distractor", "ficha": "тебя́", "explica": "тебя́ es «a ti»; con «usted» se usa вас."}]}
