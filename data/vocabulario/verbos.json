    {"id": "pido-cafe", "idea": "Di que pides un café.", "fichas": ["Я", "зака́зываю", "ко́фе"], "validas": ["Я зака́зываю ко́фе", "Ко́фе я зака́зываю"], "texto": "Я зака́зываю ко́фе.", "fonetica": "ia za-KA-zy-va-iu KO-fe", "es": "Pido un café.", "opciones": ["Pido un café.", "Compro un café.", "Pediste un café.", "Preparo un café."], "distractores": ["покупа́ю", "гото́влю"], "pista": "«Ко'фе» no cambia nunca.", "diccionario": [{"ficha": "Я", "forma": "я", "es": "yo", "fonetica": "ia", "porque": ""}, {"ficha": "зака́зываю", "forma": "зака́зывать", "es": "ordenar, pedir (en un lugar)", "fonetica": "za-KA-zy-va-iu", "porque": "Presente con я: зака'зывать → зака'зываю."}, {"ficha": "ко́фе", "forma": "ко́фе", "es": "café (la bebida)", "fonetica": "KO-fe", "porque": ""}, {"ficha": "покупа́ю", "forma": "покупа́ть", "es": "comprar", "fonetica": "pa-ku-PA-iu", "porque": "Presente con я: покупа'ть → покупа'ю."}, {"ficha": "гото́влю", "forma": "гото́вить", "es": "preparar, cocinar", "fonetica": "ga-TO-vliu", "porque": "Presente con я: гото'вить → гото'влю."}], "bloques": [["Я", "зака́зываю"], ["ко́фе"]], "fijo": false, "errores": [{"tipo": "bloque", "fichas": ["Я", "зака́зываю"], "explica": "Я и зака́зываю van juntas: зака́зываю es la forma de я."}, {"tipo": "distractor", "ficha": "покупа́ю", "explica": "покупа́ю es «compro»; la idea dice pido: зака́зываю."}, {"tipo": "distractor", "ficha": "гото́влю", "explica": "гото́влю es «preparo»; la idea dice pido: зака́зываю."}]},
