    {"id": "le-encanta-cantar", "idea": "Di que a ella le encanta cantar.", "fichas": ["Она́", "лю́бит", "петь"], "validas": ["Она́ лю́бит петь"], "texto": "Она́ лю́бит петь.", "fonetica": "a-NA LIU-bit piet'", "es": "A ella le encanta cantar.", "opciones": ["A ella le encanta bailar.", "A ella le encanta cantar.", "A él le encanta cantar.", "Ella cantaba."], "distractores": ["танцева́ть", "лю́бишь"], "pista": "Después de «люби'ть» el segundo verbo queda sin cambiar.", "diccionario": [{"ficha": "Она́", "forma": "она́", "es": "ella", "fonetica": "a-NA", "porque": ""}, {"ficha": "лю́бит", "forma": "люби́ть", "es": "amar, querer, gustar mucho", "fonetica": "LIU-bit", "porque": "Presente con он/она': люби'ть → лю'бит."}, {"ficha": "петь", "forma": "петь", "es": "cantar", "fonetica": "piet'", "porque": ""}, {"ficha": "танцева́ть", "forma": "танцева́ть", "es": "bailar", "fonetica": "tan-tsi-VAT'", "porque": ""}, {"ficha": "лю́бишь", "forma": "люби́ть", "es": "amar, querer, gustar mucho", "fonetica": "LIU-bish", "porque": "Presente con ты: люби'ть → лю'бишь."}], "bloques": [["Она́", "лю́бит"], ["петь"]], "fijo": true, "errores": [{"tipo": "bloque", "fichas": ["Она́", "лю́бит"], "explica": "Она́ и лю́бит van juntas: лю́бит es la forma de она́."}, {"tipo": "orden", "explica": "Primero quién y qué siente (она́ лю́бит) y al final el verbo en infinitivo: петь."}, {"tipo": "distractor", "ficha": "танцева́ть", "explica": "танцева́ть es «bailar»; la idea dice cantar: петь."}, {"tipo": "distractor", "ficha": "лю́бишь", "explica": "лю́бишь es la forma de ты; con она́ es лю́бит."}]},
    {"id": "conversamos", "idea": "Di que ahora estamos conversando.", "fichas": ["Мы", "сейча́с", "разгова́риваем"], "validas": ["Мы сейча́с разгова́риваем", "Сейча́с мы разгова́риваем"], "texto": "Мы сейча́с разгова́риваем.", "fonetica": "my si-CHAS raz-ga-VA-ri-va-iem", "es": "Ahora estamos conversando.", "opciones": ["Ahora estamos trabajando.", "Ahora ustedes conversan.", "Ahora estamos conversando.", "Ahora estábamos conversando."], "distractores": ["разгова́риваете", "рабо́таем"], "pista": "Con «мы» el verbo termina en -ем.", "diccionario": [{"ficha": "Мы", "forma": "мы", "es": "nosotros", "fonetica": "my", "porque": ""}, {"ficha": "сейча́с", "forma": "сейча́с", "es": "ahora", "fonetica": "si-CHAS", "porque": ""}, {"ficha": "разгова́риваем", "forma": "разгова́ривать", "es": "conversar, dialogar", "fonetica": "raz-ga-VA-ri-va-iem", "porque": "Presente con мы: разгова'ривать → разгова'риваем."}, {"ficha": "разгова́риваете", "forma": "разгова́ривать", "es": "conversar, dialogar", "fonetica": "raz-ga-VA-ri-va-ie-tie", "porque": "Presente con вы: разгова'ривать → разгова'риваете."}, {"ficha": "рабо́таем", "forma": "рабо́тать", "es": "trabajar, funcionar", "fonetica": "ra-BO-ta-iem", "porque": "Presente con мы: рабо'тать → рабо'таем."}], "bloques": [["Мы", "сейча́с"], ["разгова́риваем"]], "fijo": false, "errores": [{"tipo": "bloque", "fichas": ["Мы", "сейча́с"], "explica": "Мы и сейча́с van juntas: сейча́с = ahora."}, {"tipo": "distractor", "ficha": "разгова́риваете", "explica": "разгова́риваете es la forma de вы; con мы es разгова́риваем."}, {"tipo": "distractor", "ficha": "рабо́таем", "explica": "рабо́таем es «trabajamos»; la idea dice conversar: разгова́риваем."}]},
    {"id": "el-no-entiende", "idea": "Di que él no entiende pero tú sí.", "fichas": ["Он", "не", "понима́ет", "а", "я", "понима́ю"], "validas": ["Он не понима́ет а я понима́ю", "Я понима́ю а он не понима́ет"], "texto": "Он не понима́ет, а я понима́ю.", "fonetica": "on ni pa-ni-MA-iet a ia pa-ni-MA-iu", "es": "Él no entiende, pero yo entiendo.", "opciones": ["Yo no entiendo, pero él entiende.", "Él no recuerda, pero yo entiendo.", "Él no entiende y tú tampoco.", "Él no entiende, pero yo entiendo."], "distractores": ["понима́ешь", "по́мнит"], "pista": "El mismo verbo cambia con cada persona.", "diccionario": [{"ficha": "Он", "forma": "он", "es": "él", "fonetica": "on", "porque": ""}, {"ficha": "не", "forma": "не", "es": "no (niega la palabra siguiente)", "fonetica": "ni", "porque": ""}, {"ficha": "понима́ет", "forma": "понима́ть", "es": "entender", "fonetica": "pa-ni-MA-iet", "porque": "Presente con он: понима'ть → понима'ет."}, {"ficha": "а", "forma": "а", "es": "y, en cambio", "fonetica": "a", "porque": ""}, {"ficha": "я", "forma": "я", "es": "yo", "fonetica": "ia", "porque": ""}, {"ficha": "понима́ю", "forma": "понима́ть", "es": "entender", "fonetica": "pa-ni-MA-iu", "porque": "Presente con я: понима'ть → понима'ю."}, {"ficha": "понима́ешь", "forma": "понима́ть", "es": "entender", "fonetica": "pa-ni-MA-iesh", "porque": "Presente con ты: понима'ть → понима'ешь."}, {"ficha": "по́мнит", "forma": "по́мнить", "es": "recordar", "fonetica": "POM-nit", "porque": "Presente con он: по'мнить → по'мнит."}], "bloques": [["Он", "не", "понима́ет"], ["а"], ["я", "понима́ю"]], "fijo": false, "errores": [{"tipo": "bloque", "fichas": ["Он", "не", "понима́ет"], "explica": "Он, не y понима́ет van juntos: не va justo antes de понима́ет."}, {"tipo": "bloque", "fichas": ["я", "понима́ю"], "explica": "я и понима́ю van juntos: понима́ю es la forma de я."}, {"tipo": "distractor", "ficha": "понима́ешь", "explica": "понима́ешь es la forma de ты; con я es понима́ю."}, {"tipo": "distractor", "fi