    {"id": "amistad-alegria", "idea": "Di que la amistad es alegría.", "fichas": ["Дру́жба", "ра́дость"], "validas": ["Дру́жба ра́дость"], "texto": "Дру́жба — ра́дость.", "fonetica": "DRUZH-ba RA-dast'", "es": "La amistad es alegría.", "opciones": ["La amistad es alegría.", "El amor es alegría.", "La amistad es un problema.", "La amistad era alegría."], "distractores": ["любо́вь", "жизнь"], "pista": "Sin «es» en presente: se pone una raya.", "diccionario": [{"ficha": "Дру́жба", "forma": "дру́жба", "es": "amistad", "fonetica": "DRUZH-ba", "porque": ""}, {"ficha": "ра́дость", "forma": "ра́дость", "es": "alegría", "fonetica": "RA-dast'", "porque": ""}, {"ficha": "любо́вь", "forma": "любо́вь", "es": "amor", "fonetica": "liu-BOF'", "porque": ""}, {"ficha": "жизнь", "forma": "жизнь", "es": "vida", "fonetica": "zhyzn'", "porque": ""}], "bloques": [["Дру́жба"], ["ра́дость"]], "fijo": true, "errores": [{"tipo": "orden", "explica": "Primero el tema (дру́жба) y luego lo que es (ра́дость). En presente no se dice «es»."}, {"tipo": "distractor", "ficha": "любо́вь", "explica": "любо́вь es «amor»; la idea dice amistad y alegría."}, {"tipo": "distractor", "ficha": "жизнь", "explica": "жизнь es «vida»; la idea dice amistad y alegría."}]},
    {"id": "tengo-sueno", "idea": "Di que tienes un sueño (una aspiración).", "fichas": ["У", "меня́", "есть", "мечта́"], "validas": ["У меня́ есть мечта́"], "texto": "У меня́ есть мечта́.", "fonetica": "u mi-NIA yest' mich-TA", "es": "Tengo un sueño.", "opciones": ["Tengo un problema.", "Tengo un sueño.", "Tengo una idea.", "Tenía un sueño."], "distractores": ["иде́я", "сон"], "pista": "No es el sueño de dormir.", "diccionario": [{"ficha": "У", "forma": "у", "es": "junto a, en casa de (у меня' = yo tengo)", "fonetica": "u", "porque": ""}, {"ficha": "меня́", "forma": "я", "es": "yo (a mí)", "fonetica": "mi-NIA", "porque": "Con «зову'т» y «у» se usa la forma меня': я → меня'."}, {"ficha": "есть", "forma": "быть", "es": "haber, tener (есть = hay)", "fonetica": "yest'", "porque": "Presente de быть: у меня' есть = tengo."}, {"ficha": "мечта́", "forma": "мечта́", "es": "sueño, anhelo", "fonetica": "mich-TA", "porque": ""}, {"ficha": "иде́я", "forma": "иде́я", "es": "idea", "fonetica": "i-DIE-ia", "porque": ""}, {"ficha": "сон", "forma": "сон", "es": "sueño (dormir)", "fonetica": "son", "porque": ""}], "bloques": [["У", "меня́", "есть"], ["мечта́"]], "fijo": true, "errores": [{"tipo": "bloque", "fichas": ["У", "меня́", "есть"], "explica": "У, меня́ y есть van juntas: у меня́ есть = tengo."}, {"tipo": "orden", "explica": "Empieza con у меня́ есть (tengo) y al final va lo que tienes."}, {"tipo": "distractor", "ficha": "иде́я", "explica": "иде́я es «idea»; el sueño que deseas es мечта́."}, {"tipo": "distractor", "ficha": "сон", "explica": "сон es el sueño al dormir; el sueño que deseas es мечта́."}]},
    {"id": "miedo-risa", "idea": "Di que tú tienes miedo y a él le da risa.", "fichas": ["Мне", "стра́шно", "а", "ему́", "смешно́"], "validas": ["Мне стра́шно а ему́ смешно́", "Ему́ смешно́ а мне стра́шно"], "texto": "Мне стра́шно, а ему́ смешно́.", "fonetica": "mnie STRASH-na a i-MU smish-NO", "es": "Tengo miedo y a él le da risa.", "opciones": ["Me da risa y a él miedo.", "Tengo miedo y a ella le da risa.", "Tengo miedo y a él le da risa.", "Me aburro y a él le da risa."], "distractores": ["ску́чно", "ей"], "pista": "El sentimiento se dice con «мне» o «ему'».", "diccionario": [{"ficha": "Мне", "forma": "я", "es": "yo (a mí)", "fonetica": "mnie", "porque": "Cambia como я → мне (para sentimientos)."}, {"ficha": "стра́шно", "forma": "стра́шно", "es": "da miedo", "fonetica": "STRASH-na", "porque": ""}, {"ficha": "а", "forma": "а", "es": "y, en cambio", "fonetica": "a", "porque": ""}, {"ficha": "ему́", "forma": "он", "es": "él (a él)", "fonetica": "i-MU", "porque": "Cambia como он → ему' (para sentimientos)."}, {"ficha": "смешно́", "forma": "смешно́", "es": "da risa, es gracioso", "fonetica": "smish-NO", "porque": ""}, {"ficha": "ску́чно", "forma": "ску́чно", "es": "es aburrido", "fonetica": "SKUSH-na", "porque": ""}, {"ficha": "ей", "forma": "она́", "es": "ella (a ella)", "fonetica": "iei", "porque": "Cambia como она' → ей."}], "bloques": [["Мне", "стра́шно"], ["а"], ["ему́", "смешно́"]], "fijo": false, "errores": [{"tipo": "bloque", "fichas": ["Мне", "стра́шно"], "explica": "Мне и стра́шно van juntas: мне стра́шно = tengo miedo."}, {"tipo": "bloque", "fichas": ["ему́", "смешно́"], "explica": "ему́ и смешно́ van juntas: ему́ смешно́ = a él le da risa."}, {"tipo": "distractor", "ficha": "ску́чно", "explica": "ску́чно es «aburrido»; la idea dice risa: смешно́."}, {"tipo": "distractor", "ficha": "ей", "explica": "ей es «a ella»; la idea dice «a él»: ему́."}]},
    {"id": "vida-guerra", "idea": "Di que la vida no es guerra.", "fichas": ["Жизнь", "э́то", "не", "война́"], "validas": ["Жизнь э́то не война́"], "texto": "Жизнь — э́то не война́.", "fonetica": "zhyzn' E-ta ni vai-NA", "es": "La vida no es guerra.", "opciones": ["La vida es guerra.", "La vida no es un sueño.", "La guerra no es vida.", "La vida no es guerra."], "distractores": ["револю́ция", "сон"], "pista": "«Не» va justo antes de la palabra que niegas.", "diccionario": [{"ficha": "Жизнь", "forma": "жизнь", "es": "vida", "fonetica": "zhyzn'", "porque": ""}, {"ficha": "э́то", "forma": "э́то", "es": "esto, esto es", "fonetica": "E-ta", "porque": ""}, {"ficha": "не", "forma": "не", "es": "no (niega la palabra siguiente)", "fonetica": "ni", "porque": ""}, {"ficha": "война́", "forma": "война́", "es": "guerra", "fonetica": "vai-NA", "porque": ""}, {"ficha": "револю́ция", "forma": "револю́ция", "es": "revolución", "fonetica": "ri-va-LIU-tsiia", "porque": ""}, {"ficha": "сон", "forma": "сон", "es": "sueño (dormir)", "fonetica": "son", "porque": ""}], "bloques": [["Жизнь"], ["э́то", "не", "война́"]], "fijo": true, "errores": [{"tipo": "bloque", "fichas": ["э́то", "не", "война́"], "explica": "э́то, не y война́ van juntas: не va justo antes de война́."}, {"tipo": "orden", "explica": "Primero de qué hablas (жизнь) y después lo que no es (э́то не война́)."}, {"tipo": "distractor", "ficha": "револю́ция", "explica": "револю́ция es «revolución»; la idea dice guerra: война́."}, {"tipo": "distractor", "ficha": "сон", "explica": "сон es «sueño»; la idea dice guerra: война́."}]},
    {"id": "buen-humor", "idea": "Di que hoy tienes buen humor.", "fichas": ["Сего́дня", "у", "меня́", "хоро́шее", "настрое́ние"], "validas": ["Сего́дня у меня́ хоро́шее настрое́ние", "У меня́ сего́дня хоро́шее настрое́ние"], "texto": "Сего́дня у меня́ хоро́шее настрое́ние.", "fonetica": "si-VOD-nia u mi-NIA kha-RO-shee nas-tra-IE-nie", "es": "Hoy tengo buen humor.", "opciones": ["Hoy tengo buen humor.", "Hoy tengo mal humor.", "Ayer tuve buen humor.", "Hoy tienes buen humor."], "distractores": ["хорошо́", "ю́мор"], "pista": "«Настрое'ние» es neutro.", "diccionario": [{"ficha": "Сего́дня", "forma": "сего́дня", "es": "hoy", "fonetica": "si-VOD-nia", "porque": ""}, {"ficha": "у", "forma": "у", "es": "junto a, en casa de (у меня' = yo tengo)", "fonetica": "u", "porque": ""}, {"ficha": "меня́", "forma": "я", "es": "yo (a mí)", "fonetica": "mi-NIA", "porque": "Con «зову'т» y «у» se usa la forma меня': я → меня'."}, {"ficha": "хоро́шее", "forma": "хоро́ший", "es": "bueno", "fonetica": "kha-RO-shee", "porque": "Neutro (con настрое'ние): хоро'ший → хоро'шее."}, {"ficha": "настрое́ние", "forma": "настрое́ние", "es": "estado de ánimo, humor", "fonetica": "nas-tra-IE-ni-ie", "porque": ""}, {"ficha": "хорошо́", "forma": "хорошо́", "es": "bien", "fonetica": "kha-ra-SHO", "porque": ""}, {"ficha": "ю́мор", "forma": "ю́мор", "es": "humor", "fonetica": "YU-mar", "porque": ""}], "bloques": [["Сего́дня"], ["у", "меня́"], ["хоро́шее", "настрое́ние"]], "fijo": false, "errores": [{"tipo": "bloque", "fichas": ["у", "меня́"], "explica": "У и меня́ van juntas: у меня́ = yo tengo."}, {"tipo": "bloque", "fichas": ["хоро́шее", "настрое́ние"], "explica": "хоро́шее и настрое́ние van juntas: el adjetivo va antes del sustantivo."}, {"tipo": "distractor", "ficha": "хорошо́", "explica": "хорошо́ es un adverbio; antes de настрое́ние se usa хоро́шее."}, {"tipo": "distractor", "ficha": "ю́мор", "explica": "ю́мор es el humor de las bromas; aquí hablas del ánimo: настрое́ние."}]}
