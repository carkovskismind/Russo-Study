    {"id": "carne-sopa", "idea": "Di que hay carne en la sopa.", "fichas": ["В", "супе", "есть", "мя́со"], "validas": ["В супе есть мя́со", "Мя́со есть в супе"], "texto": "В супе есть мя́со.", "fonetica": "f SU-pie yest' MIA-sa", "es": "Hay carne en la sopa.", "opciones": ["Hay pan en la sopa.", "Hay carne en la ensalada.", "Había carne en la sopa.", "Hay carne en la sopa."], "distractores": ["сала́те", "хлеб"], "pista": "«Hay» se dice con «есть».", "diccionario": [{"ficha": "В", "forma": "в", "es": "en, a", "fonetica": "v", "porque": ""}, {"ficha": "супе", "forma": "суп", "es": "sopa", "fonetica": "SU-pie", "porque": "Después de в (dónde) se agrega -е: суп → в супе."}, {"ficha": "есть", "forma": "быть", "es": "haber, tener (есть = hay)", "fonetica": "yest'", "porque": "Presente de быть: у меня' есть = tengo."}, {"ficha": "мя́со", "forma": "мя́со", "es": "carne", "fonetica": "MIA-sa", "porque": ""}, {"ficha": "сала́те", "forma": "сала́т", "es": "ensalada", "fonetica": "sa-LA-tie", "porque": "Después de в se agrega -е: сала'т → в сала'те."}, {"ficha": "хлеб", "forma": "хлеб", "es": "pan", "fonetica": "khlep", "porque": ""}], "bloques": [["В", "супе"], ["есть"], ["мя́со"]], "fijo": false, "errores": [{"tipo": "bloque", "fichas": ["В", "супе"], "explica": "в и супе van juntas: супе cambia después de в (dónde)."}, {"tipo": "distractor", "ficha": "сала́те", "explica": "сала́те es «ensalada»; la idea habla de sopa."}, {"tipo": "distractor", "ficha": "хлеб", "explica": "хлеб es «pan»; la idea dice carne: мя́со."}]},
