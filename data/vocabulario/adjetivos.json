    {"id": "hermana-creativa", "idea": "Di que tu hermana es muy creativa.", "fichas": ["Моя́", "сестра́", "о́чень", "тво́рческая"], "validas": ["Моя́ сестра́ о́чень тво́рческая"], "texto": "Моя́ сестра́ о́чень тво́рческая.", "fonetica": "ma-IA sis-TRA O-chin' TVOR-chis-ka-ia", "es": "Mi hermana es muy creativa.", "opciones": ["Mi hermana es muy fuerte.", "Mi hermana es muy creativa.", "Mi hermano es muy creativo.", "Mi hermana era muy creativa."], "distractores": ["си́льная", "тво́рческий"], "pista": "Adjetivo femenino: termina en -ая.", "diccionario": [{"ficha": "Моя́", "forma": "мой", "es": "mi", "fonetica": "ma-IA", "porque": "Con соба'ка (femenino): мой → моя'."}, {"ficha": "сестра́", "forma": "сестра́", "es": "hermana", "fonetica": "sis-TRA", "porque": ""}, {"ficha": "о́чень", "forma": "о́чень", "es": "muy, mucho", "fonetica": "O-chin'", "porque": ""}, {"ficha": "тво́рческая", "forma": "тво́рческий", "es": "creativo, artístico", "fonetica": "TVOR-chis-ka-ia", "porque": "Femenino (con сестра'): тво'рческий → тво'рческая."}, {"ficha": "си́льная", "forma": "си́льный", "es": "fuerte", "fonetica": "SIL'-na-ia", "porque": "Femenino: си'льный → си'льная."}, {"ficha": "тво́рческий", "forma": "тво́рческий", "es": "creativo, artístico", "fonetica": "TVOR-chis-kii", "porque": ""}], "bloques": [["Моя́", "сестра́"], ["о́чень"], ["тво́рческая"]], "fijo": true, "errores": [{"tipo": "bloque", "fichas": ["Моя́", "сестра́"], "explica": "Моя́ и сестра́ van juntas: моя́ сестра́ = mi hermana."}, {"tipo": "orden", "explica": "Primero quién (моя́ сестра́) y luego cómo es (о́чень тво́рческая)."}, {"tipo": "distractor", "ficha": "си́льная", "explica": "си́льная es «fuerte»; la idea dice creativa."}, {"tipo": "distractor", "ficha": "тво́рческий", "explica": "тво́рческий es masculino; сестра́ es femenina: тво́рческая."}]},
    {"id": "casa-grande", "idea": "Di que aquí hay una casa grande y allá una pequeña.", "fichas": ["Здесь", "большо́й", "дом", "а", "там", "ма́ленький"], "validas": ["Здесь большо́й дом а там ма́ленький", "Там ма́ленький а здесь большо́й дом"], "texto": "Здесь большо́й дом, а там ма́ленький.", "fonetica": "zdies' bal'-SHOI dom a tam MA-lien'-kii", "es": "Aquí hay una casa grande y allá una pequeña.", "opciones": ["Aquí hay una casa pequeña y allá una grande.", "Aquí hay una casa grande y allá una nueva.", "Aquí hay una casa grande y allá una pequeña.", "Aquí hay un edificio grande y allá una pequeña."], "distractores": ["но́вый", "ма́ленькая"], "pista": "«Дом» es masculino: los adjetivos terminan en -ой / -ий.", "diccionario": [{"ficha": "Здесь", "forma": "здесь", "es": "aquí", "fonetica": "zdies'", "porque": ""}, {"ficha": "большо́й", "forma": "большо́й", "es": "grande", "fonetica": "bal'-SHOI", "porque": ""}, {"ficha": "дом", "forma": "дом", "es": "casa", "fonetica": "dom", "porque": ""}, {"ficha": "а", "forma": "а", "es": "y, en cambio", "fonetica": "a", "porque": ""}, {"ficha": "там", "forma": "там", "es": "allí, allá", "fonetica": "tam", "porque": ""}, {"ficha": "ма́ленький", "forma": "ма́ленький", "es": "pequeño", "fonetica": "MA-lien'-kii", "porque": ""}, {"ficha": "но́вый", "forma": "но́вый", "es": "nuevo", "fonetica": "NO-vyi", "porque": ""}, {"ficha": "ма́ленькая", "forma": "ма́ленький", "es": "pequeño", "fonetica": "MA-lien'-ka-ia", "porque": "Femenino: ма'ленький → ма'ленькая."}], "bloques": [["Здесь", "большо́й", "дом"], ["а"], ["там", "ма́ленький"]], "fijo": false, "errores": [{"tipo": "bloque", "fichas": ["Здесь", "большо́й", "дом"], "explica": "Здесь, большо́й y дом van juntos: здесь большо́й дом = aquí hay una casa grande."}, {"tipo": "bloque", "fichas": ["там", "ма́ленький"], "explica": "там и ма́ленький van juntos: там ма́ленький = allá una pequeña."}, {"tipo": "distractor", "ficha": "но́вый", "explica": "но́вый es «nuevo»; la idea habla de grand