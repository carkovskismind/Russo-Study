    {"id": "no-comedia", "idea": "Aclara que no es una comedia, es una policiaca.", "fichas": ["Э́то", "не", "коме́дия", "э́то", "детекти́в"], "validas": ["Э́то не коме́дия э́то детекти́в"], "texto": "Э́то не коме́дия, э́то детекти́в.", "fonetica": "E-ta ni ka-MIE-dia E-ta di-tik-TIF", "es": "No es una comedia, es una película policiaca.", "opciones": ["Es una comedia, no un policiaco.", "No es un policiaco, es una comedia.", "No es una comedia, es una película policiaca.", "No es una comedia, es de acción."], "distractores": ["э́кшн", "кримина́л"], "pista": "Primero niegas un género y luego dices el correcto.", "diccionario": [{"ficha": "Э́то", "forma": "э́то", "es": "esto, esto es", "fonetica": "E-ta", "porque": ""}, {"ficha": "не", "forma": "не", "es": "no (niega la palabra siguiente)", "fonetica": "ni", "porque": ""}, {"ficha": "коме́дия", "forma": "коме́дия", "es": "comedia", "fonetica": "ka-MIE-dia", "porque": ""}, {"ficha": "э́то", "forma": "э́то", "es": "esto, esto es", "fonetica": "E-ta", "porque": ""}, {"ficha": "детекти́в", "forma": "детекти́в", "es": "película o novela policiaca", "fonetica": "di-tik-TIF", "porque": ""}, {"ficha": "э́кшн", "forma": "э́кшн", "es": "acción (género)", "fonetica": "EK-shn", "porque": ""}, {"ficha": "кримина́л", "forma": "кримина́л", "es": "crimen (género)", "fonetica": "kri-mi-NAL", "porque": ""}], "bloques": [["Э́то", "не", "коме́дия"], ["э́то", "детекти́в"]], "fijo": true, "errores": [{"tipo": "bloque", "fichas": ["Э́то", "не", "коме́дия"], "explica": "Э́то, не y коме́дия van juntas: не va justo antes de коме́дия."}, {"tipo": "bloque", "fichas": ["э́то", "детекти́в"], "explica": "Э́то и детекти́в van juntos: э́то детекти́в = es policiaca."}, {"tipo": "orden", "explica": "Primero lo que no es (э́то не коме́дия) y luego lo que sí es (э́то детекти́в)."}, {"tipo": "distractor", "ficha": "э́кшн", "explica": "экшн es «acción»; la idea dice policiaca: детекти́в."}, {"tipo": "distractor", "ficha": "кримина́л", "explica": "кримина́