  "aprender": {"intro": "Del 0 al 1000 y los primeros ordinales (primero, segundo…). Sirven para la edad, los precios, la hora y los teléfonos.", "reglas": ["El 1 y el 2 cambian con el género: оди́н брат, одна́ сестра́, одно́ и́мя · два бра́та, две сестры́.", "Después de 2, 3 y 4 la palabra cambia su final: él / ello + -а (два бра́та, три сы́на); ella: -а → -ы, o -и después de к, г, х (две сестры́, три ко́шки). De 5 en adelante cambia otra vez: пять лет, пять челове́к."], "tip": "Del 11 al 19 todos terminan en -надцать («sobre diez»): оди́ннадцать = uno sobre diez."},
  "frases": [
    {"id": "mi-numero", "idea": "Da tu número: ocho, cinco, tres.", "fichas": ["Мой", "но́мер", "во́семь", "пять", "три"], "validas": ["Мой но́мер во́семь пять три"], "texto": "Мой но́мер — во́семь пять три.", "fonetica": "moi NO-mier VO-siem' piat' tri", "es": "Mi número es ocho, cinco, tres.", "opciones": ["Mi número es ocho, cinco, tres.", "Mi número es ocho, tres, cinco.", "Mi número es cinco, ocho, tres.", "Su número es ocho, cinco, tres."], "distractores": ["шесть", "семь"], "pista": "Los dígitos van en el mismo orden en que los dices.", "diccionario": [{"ficha": "Мой", "forma": "мой", "es": "mi", "fonetica": "moi", "porque": "Masculino: мой."}, {"ficha": "но́мер", "forma": "но́мер", "es": "número", "fonetica": "NO-mier", "porque": ""}, {"ficha": "во́семь", "forma": "во́семь", "es": "ocho", "fonetica": "VO-siem'", "porque": ""}, {"ficha": "пять", "forma": "пять", "es": "cinco", "fonetica": "piat'", "porque": ""}, {"ficha": "три", "forma": "три", "es": "tres", "fonetica": "tri", "porque": ""}, {"ficha": "шесть", "forma": "шесть", "es": "seis", "fonetica": "shest'", "porque": ""}, {"ficha": "семь", "forma": "семь", "es": "siete", "fonetica": "siem'", "porque": ""}], "bloques": [["Мой", "но́мер"], ["во́семь", "пять", "три"]], "fijo": true, "errores": [{"tipo": "bloque", "fichas": ["Мой", "но́мер"], "explica": "Мой и но́мер van juntos: мой но́мер = mi número."}, {"tipo": "bloque", "fichas": ["во́семь", "пять", "три"], "explica": "во́семь пять три van juntos: los dígitos van en ese orden."}, {"tipo": "orden", "explica": "Primero мой но́мер y después los dígitos en el orden de la idea."}, {"tipo": "distractor", "ficha": "шесть", "explica": "шесть es «seis»; no está en el número de la idea."}, {"tipo": "distractor", "ficha": "семь", "explica": "семь es «siete»; no está en el número de la idea."}]},
    {"id": "uno-dos-tres", "idea": "Di que aquí hay uno y allá dos o tres.", "fichas": ["Здесь", "оди́н", "а", "там", "два", "и́ли", "три"], "validas": ["Здесь оди́н а там два и́ли три", "Там два и́ли три а здесь оди́н"], "texto": "Здесь оди́н, а там два и́ли три.", "fonetica": "zdies' a-DIN, a tam dva I-li tri", "es": "Aquí hay uno y allá dos o tres.", "opciones": ["Aquí hay dos y allá uno o tres.", "Aquí hay uno y allá dos o tres.", "Aquí hay uno y allá dos y tres.", "Aquí hay uno y allá tres o cuatro."], "distractores": ["четы́ре", "и"], "pista": "Dos lugares; а los contrasta.", "diccionario": [{"ficha": "Здесь", "forma": "здесь", "es": "aquí", "fonetica": "zdies'", "porque": ""}, {"ficha": "оди́н", "forma": "оди́н", "es": "uno", "fonetica": "a-DIN", "porque": ""}, {"ficha": "а", "forma": "а", "es": "y, en cambio", "fonetica": "a", "porque": ""}, {"ficha": "там", "forma": "там", "es": "allí, allá", "fonetica": "tam", "porque": ""}, {"ficha": "два", "forma": "два", "es": "dos", "fonetica": "dva", "porque": ""}, {"ficha": "и́ли", "forma": "и́ли", "es": "o", "fonetica": "I-li", "porque": ""}, {"ficha": "три", "forma": "три", "es": "tres", "fonetica": "tri", "porque": ""}, {"ficha": "четы́ре", "forma": "четы́ре", "es": "cuatro", "fonetica": "chi-TY-rie", "porque": ""}, {"ficha": "и", "forma": "и", "es": "y", "fonetica": "i", "porque": ""}], "bloques": [["Здесь", "оди́н"], ["а"], ["там", "два", "и́ли", "три"]], "fijo": true, "errores": [{"tipo": "bloque", "fichas": ["Здесь", "оди́н"], "explica": "Здесь y оди́н van juntas: здесь оди́н = aquí hay uno."}, {"tipo": "bloque", "fichas": ["там", "два", "и́ли", "три"], "explica": "Там, два, и́ли y три van juntas: там два и́ли три = allá hay dos o tres."}, {"tipo": "distractor", "ficha": "четы́ре", "explica": "четы́ре es «cuatro»; la idea llega hasta tres."}, {"tipo": "distractor", "ficha": "и", "explica": "и es «y»; la idea dice «dos o tres»: и́ли."}, {"tipo": "orden", "explica": "Cada lugar con sus números, y а antes del segundo: Здесь оди́н, а там два и́ли три."}], "enfasis": [{"ru": "Здесь оди́н а там два и́ли три", "nota": "Orden neutro: sigue la idea; después de а va el contraste: allá hay dos o tres."}, {"ru": "Там два и́ли три а здесь оди́н", "nota": "Empiezas por allá; ahora el contraste es lo de aquí: solo uno."}]},
    {"id": "cinco-seis", "idea": "Di que aquí hay cinco y allá seis.", "fichas": ["Здесь", "пять", "а", "там", "шесть"], "validas": ["Здесь пять а там шесть", "Там шесть а здесь пять"], "texto": "Здесь пять, а там шесть.", "fonetica": "zdies' piat', a tam shest'", "es": "Aquí hay cinco y allá seis.", "opciones": ["Aquí hay cinco y allá seis.", "Aquí hay seis y allá cinco.", "Aquí hay cinco y allá siete.", "Aquí hay cinco y también allá."], "distractores": ["семь", "три"], "pista": "Dos lugares y dos números; а los contrasta.", "diccionario": [{"ficha": "Здесь", "forma": "здесь", "es": "aquí", "fonetica": "zdies'", "porque": ""}, {"ficha": "пять", "forma": "пять", "es": "cinco", "fonetica": "piat'", "porque": ""}, {"ficha": "а", "forma": "а", "es": "y, en cambio", "fonetica": "a", "porque": ""}, {"ficha": "там", "forma": "там", "es": "allí, allá", "fonetica": "tam", "porque": ""}, {"ficha": "шесть", "forma": "шесть", "es": "seis", "fonetica": "shest'", "porque": ""}, {"ficha": "семь", "forma": "семь", "es": "siete", "fonetica": "siem'", "porque": ""}, {"ficha": "три", "forma": "три", "es": "tres", "fonetica": "tri", "porque": ""}], "bloques": [["Здесь", "пять"], ["а"], ["там", "шесть"]], "fijo": true, "errores": [{"tipo": "bloque", "fichas": ["Здесь", "пять"], "explica": "Здесь y пять van juntas: здесь пять = aquí hay cinco."}, {"tipo": "bloque", "fichas": ["там", "шесть"], "explica": "Там y шесть van juntas: там шесть = allá hay seis."}, {"tipo": "distractor", "ficha": "семь", "explica": "семь es «siete»; la idea dice seis: шесть."}, {"tipo": "distractor", "ficha": "три", "explica": "три es «tres»; la idea habla de cinco y seis."}, {"tipo": "orden", "explica": "Cada lugar va con su número, y а va antes del segundo: Здесь пять, а там шесть."}], "enfasis": [{"ru": "Здесь пять а там шесть", "nota": "Orden neutro: sigue la idea; después de а va el contraste: allá hay seis."}, {"ru": "Там шесть а здесь пять", "nota": "Empiezas por allá; ahora el contraste es lo de aquí: cinco."}]},
    {"id": "un-hermano", "idea": "Di que tienes un solo hermano.", "fichas": ["У", "меня́", "оди́н", "брат"], "validas": ["У меня́ оди́н брат", "Брат у меня́ оди́н"], "texto": "У меня́ оди́н брат.", "fonetica": "u mie-NIA a-DIN brat", "es": "Tengo un hermano.", "opciones": ["Tengo un hermano.", "Tengo dos hermanos.", "Tengo una hermana.", "Tienes un hermano."], "distractores": ["два", "сестра́"], "pista": "Cuando dices cuántos tienes, no hace falta есть.", "diccionario": [{"ficha": "У", "forma": "у", "es": "junto a (у меня́ = yo tengo)", "fonetica": "u", "porque": ""}, {"ficha": "меня́", "forma": "я", "es": "yo", "fonetica": "mie-NIA", "porque": "Después de у: я → меня́. У меня́ = yo tengo."}, {"ficha": "оди́н", "forma": "оди́н", "es": "uno, un", "fonetica": "a-DIN", "porque": "Con брат (он): оди́н."}, {"ficha": "брат", "forma": "брат", "es": "hermano", "fonetica": "brat", "porque": ""}, {"ficha": "два", "forma": "два", "es": "dos", "fonetica": "dva", "porque": ""}, {"ficha": "сестра́", "forma": "сестра́", "es": "hermana", "fonetica": "sies-TRA", "porque": ""}], "bloques": [["У", "меня́"], ["оди́н", "брат"]], "fijo": true, "errores": [{"tipo": "bloque", "fichas": ["У", "меня́"], "explica": "У y меня́ van juntas: у меня́ = tengo."}, {"tipo": "bloque", "fichas": ["оди́н", "брат"], "explica": "Оди́н y брат van juntas: оди́н брат = un hermano."}, {"tipo": "distractor", "ficha": "два", "explica": "два es «dos»; la idea dice uno: оди́н."}, {"tipo": "distractor", "ficha": "сестра́", "explica": "сестра́ es «hermana»; la idea dice hermano: брат."}, {"tipo": "orden", "explica": "Lo normal es у меня́ al inicio y al final cuántos: оди́н брат."}], "enfasis": [{"ru": "У меня́ оди́н брат", "nota": "Orden neutro: al final va lo nuevo: cuántos hermanos tienes."}, {"ru": "Брат у меня́ оди́н", "nota": "Resalta el número: «hermano, solo tengo uno». Suena a respuesta o aclaración."}]},
    {"id": "no-nueve-diez", "idea": "Corrige: no es nueve, sino diez.", "fichas": ["Э́то", "не", "де́вять", "а", "де́сять"], "validas": ["Э́то не де́вять а де́сять", "Э́то де́сять а не де́вять"], "texto": "Э́то не де́вять, а де́сять.", "fonetica": "E-ta nie DIE-viat', a DIE-siat'", "es": "No es nueve, sino diez.", "opciones": ["No es nueve, sino diez.", "No es diez, sino nueve.", "Es nueve y diez.", "No es nueve, sino dos."], "distractores": ["два", "нет"], "pista": "Corriges un número con «no…, sino…».", "diccionario": [{"ficha": "Э́то", "forma": "э́то", "es": "esto, esto es", "fonetica": "E-ta", "porque": ""}, {"ficha": "не", "forma": "не", "es": "no", "fonetica": "nie", "porque": ""}, {"ficha": "де́вять", "forma": "де́вять", "es": "nueve", "fonetica": "DIE-viat'", "porque": ""}, {"ficha": "а", "forma": "а", "es": "y, en cambio", "fonetica": "a", "porque": ""}, {"ficha": "де́сять", "forma": "де́сять", "es": "diez", "fonetica": "DIE-siat'", "porque": ""}, {"ficha": "два", "forma": "два", "es": "dos", "fonetica": "dva", "porque": ""}, {"ficha": "нет", "forma": "нет", "es": "no (respuesta)", "fonetica": "niet", "porque": "нет contesta «no»; para negar una palabra se usa не."}], "bloques": [["Э́то"], ["не", "де́вять"], ["а"], ["де́сять"]], "fijo": true, "errores": [{"tipo": "bloque", "fichas": ["не", "де́вять"], "explica": "не va pegado a la palabra que niega: не де́вять = no nueve."}, {"tipo": "distractor", "ficha": "два", "explica": "два es «dos»; la idea habla de nueve y diez."}, {"tipo": "distractor", "ficha": "нет", "explica": "нет contesta «no»; para negar una palabra dentro de la frase se usa не."}, {"tipo": "orden", "explica": "Primero э́то; luego lo que no es (не де́вять) y, con а, lo que sí es (де́сять). También vale Э́то де́сять, а не де́вять."}], "enfasis": [{"ru": "Э́то не де́вять а де́сять", "nota": "Orden neutro: corriges, y lo nuevo, el número correcto, va al final: diez."}, {"ru": "Э́то де́сять а не де́вять", "nota": "Dices primero el número correcto y luego aclaras cuál no es; suena más firme."}]}
