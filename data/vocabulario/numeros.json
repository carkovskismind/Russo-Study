    {"id": "mi-numero", "idea": "Da tu número: ocho, cinco, tres.", "fichas": ["Мой", "но́мер", "во́семь", "пять", "три"], "validas": ["Мой но́мер во́семь пять три"], "texto": "Мой но́мер — во́семь пять три.", "fonetica": "moi NO-mir VO-sim' piat' tri", "es": "Mi número es ocho, cinco, tres.", "opciones": ["Mi número es ocho, cinco, tres.", "Mi número es ocho, tres, cinco.", "Mi número es cinco, ocho, tres.", "Su número es ocho, cinco, tres."], "distractores": ["шесть", "семь"], "pista": "Los dígitos van en el mismo orden en que los dices.", "diccionario": [{"ficha": "Мой", "forma": "мой", "es": "mi", "fonetica": "moi", "porque": "Masculino: мой."}, {"ficha": "но́мер", "forma": "но́мер", "es": "número", "fonetica": "NO-mir", "porque": ""}, {"ficha": "во́семь", "forma": "во́семь", "es": "ocho", "fonetica": "VO-sim'", "porque": ""}, {"ficha": "пять", "forma": "пять", "es": "cinco", "fonetica": "piat'", "porque": ""}, {"ficha": "три", "forma": "три", "es": "tres", "fonetica": "tri", "porque": ""}, {"ficha": "шесть", "forma": "шесть", "es": "seis", "fonetica": "shest'", "porque": ""}, {"ficha": "семь", "forma": "семь", "es": "siete", "fonetica": "siem'", "porque": ""}], "bloques": [["Мой", "но́мер"], ["во́семь", "пять", "три"]], "fijo": true, "errores": [{"tipo": "bloque", "fichas": ["Мой", "но́мер"], "explica": "Мой и но́мер van juntos: мой но́мер = mi número."}, {"tipo": "bloque", "fichas": ["во́семь", "пять", "три"], "explica": "во́семь пять три van juntos: los dígitos van en ese orden."}, {"tipo": "orden", "explica": "Primero мой но́мер y después los dígitos en el orden de la idea."}, {"tipo": "distractor", "ficha": "шесть", "explica": "шесть es «seis»; no está en el número de la idea."}, {"tipo": "distractor", "ficha": "семь", "explica": "семь es «siete»; no está en el número de la idea."}]},
    {"id": "uno-dos-tres", "idea": "Di que aquí hay uno, allá dos y en el centro tres.", "fichas": ["Здесь", "оди́н", "там", "два", "а", "в", "це́нтре", "три"], "validas": ["Здесь оди́н там два а в це́нтре три", "Там два здесь оди́н а в це́нтре три"], "texto": "Здесь оди́н, там два, а в це́нтре три.", "fonetica": "zdies' a-DIN tam dva a f TSEN-tre tri", "es": "Aquí hay uno, allá dos y en el centro tres.", "opciones": ["Aquí hay dos, allá uno y en el centro tres.", "Aquí hay uno, allá dos y en el centro tres.", "Aquí hay uno, allá tres y en el centro dos.", "Aquí hay uno, allá dos y a la izquierda tres."], "distractores": ["четы́ре", "сле́ва"], "pista": "Tres lugares, tres números.", "diccionario": [{"ficha": "Здесь", "forma": "здесь", "es": "aquí", "fonetica": "zdies'", "porque": ""}, {"ficha": "оди́н", "forma": "оди́н", "es": "uno", "fonetica": "a-DIN", "porque": ""}, {"ficha": "там", "forma": "там", "es": "allí, allá", "fonetica": "tam", "porque": ""}, {"ficha": "два", "forma": "два", "es": "dos", "fonetica": "dva", "porque": ""}, {"ficha": "а", "forma": "а", "es": "y, en cambio", "fonetica": "a", "porque": ""}, {"ficha": "в", "forma": "в", "es": "en, a", "fonetica": "v", "porque": ""}, {"ficha": "це́нтре", "forma": "це́нтр", "es": "centro", "fonetica": "TSEN-tre", "porque": "Después de в (dónde) se agrega -е: це'нтр → в це'нтре."}, {"ficha": "три", "forma": "три", "es": "tres", "fonetica": "tri", "porque": ""}, {"ficha": "четы́ре", "forma": "четы́ре", "es": "cuatro", "fonetica": "chi-TY-rie", "porque": ""}, {"ficha": "сле́ва", "forma": "сле́ва", "es": "a la izquierda", "fonetica": "SLIE-va", "porque": ""}], "bloques": [["Здесь", "оди́н"], ["там", "два"], ["а"], ["в", "це́нтре", "три"]], "fijo": false, "errores": [{"tipo": "bloque", "fichas": ["Здесь", "оди́н"], "explica": "Здесь и оди́н van juntos: здесь оди́н = aquí hay uno."}, {"tipo": "bloque", "fichas": ["там", "два"], "explica": "там и два van juntos: там два = allá hay dos."}, {"tipo": "bloque", "fichas": ["в", "це́нтре", "три"], "explica": "в, це́нтре y три van juntos: в це́нтре три = en el centro tres."}, {"tipo": "distractor", "ficha": "четы́ре", "explica": "четы́ре es «cuatro»; la idea llega hasta tres."}, {"tipo": "distractor", "ficha": "сле́ва", "explica": "сле́ва es «a la izquierda»; la idea dice en el centro: в це́нтре."}]},
    {"id": "primero-segundo", "idea": "Di: este es el primero y este el segundo.", "fichas": ["Э́то", "пе́рвый", "а", "э́то", "второ́й"], "validas": ["Э́то пе́рвый а э́то второ́й"], "texto": "Э́то пе́рвый, а э́то второ́й.", "fonetica": "E-ta PIER-vyi a E-ta fta-ROI", "es": "Este es el primero y este el segundo.", "opciones": ["Este es el segundo y este el primero.", "Este es el primero y este el tercero.", "Este es el primero y este el segundo.", "Este es el primero y también el segundo."], "distractores": ["тре́тий", "пя́тый"], "pista": "Los ordinales van en masculino aquí.", "diccionario": [{"ficha": "Э́то", "forma": "э́то", "es": "esto, esto es", "fonetica": "E-ta", "porque": ""}, {"ficha": "пе́рвый", "forma": "пе́рвый", "es": "primero", "fonetica": "PIER-vyi", "porque": ""}, {"ficha": "а", "forma": "а", "es": "y, en cambio", "fonetica": "a", "porque": ""}, {"ficha": "э́то", "forma": "э́то", "es": "esto, esto es", "fonetica": "E-ta", "porque": ""}, {"ficha": "второ́й", "forma": "второ́й", "es": "segundo", "fonetica": "fta-ROI", "porque": ""}, {"ficha": "тре́тий", "forma": "тре́тий", "es": "tercero", "fonetica": "TRIE-tii", "porque": ""}, {"ficha": "пя́тый", "forma": "пя́тый", "es": "quinto", "fonetica": "PIA-tyi", "porque": ""}], "bloques": [["Э́то"], ["пе́рвый"], ["а"], ["э́то"], ["второ́й"]], "fijo": true, "errores": [{"tipo": "orden", "explica": "Primero lo primero (э́то пе́рвый), luego а y lo segundo (э́то второ́й)."}, {"tipo": "distractor", "ficha": "тре́тий", "explica": "тре́тий es «tercero»; la idea habla del primero y el segundo."}, {"tipo": "distractor", "ficha": "пя́тый", "explica": "пя́тый es «quinto»; la idea habla del primero y el segundo."}]},
    {"id": "somos-cuatro", "idea": "Di que aquí son cuatro personas.", "fichas": ["Нас", "здесь", "че́тверо"], "validas": ["Нас здесь че́тверо", "Здесь нас че́тверо"], "texto": "Нас здесь че́тверо.", "fonetica": "nas zdies' CHIET-vi-ra", "es": "Aquí somos cuatro.", "opciones": ["Aquí somos cinco.", "Allá somos cuatro.", "Aquí éramos cuatro.", "Aquí somos cuatro."], "distractores": ["мы", "там"], "pista": "«Somos» se dice con «нас»; para contar personas hay una forma especial de «cuatro».", "diccionario": [{"ficha": "Нас", "forma": "мы", "es": "nosotros (a nosotros)", "fonetica": "nas", "porque": "Cambia como мы → нас."}, {"ficha": "здесь", "forma": "здесь", "es": "aquí", "fonetica": "zdies'", "porque": ""}, {"ficha": "че́тверо", "forma": "че́тверо", "es": "cuatro (personas, grupo)", "fonetica": "CHIET-vi-ra", "porque": "Para contar personas con нас se usa че́тверо (no четы́ре): нас здесь че́тверо."}, {"ficha": "мы", "forma": "мы", "es": "nosotros", "fonetica": "my", "porque": ""}, {"ficha": "там", "forma": "там", "es": "allí, allá", "fonetica": "tam", "porque": ""}], "bloques": [["Нас"], ["здесь"], ["че́тверо"]], "fijo": false, "errores": [{"tipo": "distractor", "ficha": "мы", "explica": "мы es «nosotros», pero para decir cuántos somos se usa нас."}, {"tipo": "distractor", "ficha": "там", "explica": "там es «allá»; la idea dice «aquí»: здесь."}]},
    {"id": "cien-doscientos", "idea": "Di que aquí hay cien y allá doscientos.", "fichas": ["Здесь", "сто", "а", "там", "две́сти"], "validas": ["Здесь сто а там две́сти", "Там две́сти а здесь сто"], "texto": "Здесь сто, а там две́сти.", "fonetica": "zdies' sto a tam DVIES-ti", "es": "Aquí cien y allá doscientos.", "opciones": ["Aquí cien y allá doscientos.", "Aquí doscientos y allá cien.", "Aquí cien y allá trescientos.", "Aquí cien y también allá."], "distractores": ["три́ста", "ты́сяча"], "pista": "Compara dos cantidades con «а».", "diccionario": [{"ficha": "Здесь", "forma": "здесь", "es": "aquí", "fonetica": "zdies'", "porque": ""}, {"ficha": "сто", "forma": "сто", "es": "cien", "fonetica": "sto", "porque": ""}, {"ficha": "а", "forma": "а", "es": "y, en cambio", "fonetica": "a", "porque": ""}, {"ficha": "там", "forma": "там", "es": "allí, allá", "fonetica": "tam", "porque": ""}, {"ficha": "две́сти", "forma": "две́сти", "es": "doscientos", "fonetica": "DVIES-ti", "porque": ""}, {"ficha": "три́ста", "forma": "три́ста", "es": "trescientos", "fonetica": "TRI-sta", "porque": ""}, {"ficha": "ты́сяча", "forma": "ты́сяча", "es": "mil", "fonetica": "TY-sia-cha", "porque": ""}], "bloques": [["Здесь", "сто"], ["а"], ["там", "две́сти"]], "fijo": false, "errores": [{"tipo": "bloque", "fichas": ["Здесь", "сто"], "explica": "Здесь и сто van juntos: здесь сто = aquí cien."}, {"tipo": "bloque", "fichas": ["там", "две́сти"], "explica": "там и две́сти van juntos: там две́сти = allá doscientos."}, {"tipo": "distractor", "ficha": "три́ста", "explica": "три́ста es «trescientos»; la idea dice doscientos: две́сти."}, {"tipo": "distractor", "ficha": "ты́сяча", "explica": "ты́сяча es «mil»; la idea dice cien y doscientos."}]}
