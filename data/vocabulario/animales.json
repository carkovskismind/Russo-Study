    {"id": "mi-perra", "idea": "Presenta a tu perra.", "fichas": ["Э́то", "моя́", "соба́ка"], "validas": ["Э́то моя́ соба́ка"], "texto": "Э́то моя́ соба́ка.", "fonetica": "E-ta ma-IA sa-BA-ka", "es": "Esta es mi perra.", "opciones": ["Esta es mi perra.", "Este es mi perro.", "Esta es mi gata.", "Esta es tu perra."], "distractores": ["мой", "ко́шка"], "pista": "«Соба'ка» es femenino: necesita el «mi» femenino.", "diccionario": [{"ficha": "Э́то", "forma": "э́то", "es": "esto, esto es", "fonetica": "E-ta", "porque": ""}, {"ficha": "моя́", "forma": "мой", "es": "mi", "fonetica": "ma-IA", "porque": "Con соба'ка (femenino): мой → моя'."}, {"ficha": "соба́ка", "forma": "соба́ка", "es": "perro, perra", "fonetica": "sa-BA-ka", "porque": ""}, {"ficha": "мой", "forma": "мой", "es": "mi", "fonetica": "moi", "porque": "Masculino: мой."}, {"ficha": "ко́шка", "forma": "ко́шка", "es": "gata", "fonetica": "KOSH-ka", "porque": ""}], "bloques": [["Э́то"], ["моя́", "соба́ка"]], "fijo": true, "errores": [{"tipo": "bloque", "fichas": ["моя́", "соба́ка"], "explica": "Моя́ и соба́ка van juntas: моя́ соба́ка = mi perra."}, {"tipo": "orden", "explica": "Primero э́то y después quién es: э́то моя́ соба́ка."}, {"tipo": "distractor", "ficha": "мой", "explica": "мой es masculino; соба́ка es femenina: моя́."}, {"tipo": "distractor", "ficha": "ко́шка", "explica": "ко́шка es «gata»; la idea dice perra."}]},
    {"id": "tengo-gata", "idea": "Di que tienes una gata.", "fichas": ["У", "меня́", "есть", "ко́шка"], "validas": ["У меня́ есть ко́шка"], "texto": "У меня́ есть ко́шка.", "fonetica": "u mi-NIA yest' KOSH-ka", "es": "Tengo una gata.", "opciones": ["Tengo un gato.", "Tengo una gata.", "Tenía una gata.", "Tengo una perra."], "distractores": ["кот", "соба́ка"], "pista": "«Tener» se dice con у меня' + есть.", "diccionario": [{"ficha": "У", "forma": "у", "es": "junto a, en casa de (у меня' = yo tengo)", "fonetica": "u", "porque": ""}, {"ficha": "меня́", "forma": "я", "es": "yo (a mí)", "fonetica": "mi-NIA", "porque": "Con «зову'т» y «у» se usa la forma меня': я → меня'."}, {"ficha": "есть", "forma": "быть", "es": "haber, tener (есть = hay)", "fonetica": "yest'", "porque": "Presente de быть: у меня' есть = tengo."}, {"ficha": "ко́шка", "forma": "ко́шка", "es": "gata", "fonetica": "KOSH-ka", "porque": ""}, {"ficha": "кот", "forma": "кот", "es": "gato (macho)", "fonetica": "kot", "porque": ""}, {"ficha": "соба́ка", "forma": "соба́ка", "es": "perro, perra", "fonetica": "sa-BA-ka", "porque": ""}], "bloques": [["У", "меня́", "есть"], ["ко́шка"]], "fijo": true, "errores": [{"tipo": "bloque", "fichas": ["У", "меня́", "есть"], "explica": "У, меня́ y есть van juntas: у меня́ есть = tengo."}, {"tipo": "orden", "explica": "Empieza con у меня́ есть (tengo) y al final va lo que tienes."}, {"tipo": "distractor", "ficha": "кот", "explica": "кот es un gato macho; la idea dice gata: ко́шка."}, {"tipo": "distractor", "ficha": "соба́ка", "explica": "соба́ка es «perra»; la idea dice gata."}]},
    {"id": "gato-gata", "idea": "Di que tu gato está allá y tu gata está aquí.", "fichas": ["Мой", "кот", "там", "а", "моя́", "ко́шка", "здесь"], "validas": ["Мой кот там а моя́ ко́шка здесь", "Моя́ ко́шка здесь а мой кот там"], "texto": "Мой кот там, а моя́ ко́шка здесь.", "fonetica": "moi kot tam a ma-IA KOSH-ka zdies'", "es": "Mi gato está allá y mi gata está aquí.", "opciones": ["Mi gato está aquí y mi gata allá.", "Mi gato y mi gata están allá.", "Mi gato está allá y mi gata está aquí.", "Mi gato está allá y su gata aquí."], "distractores": ["моё", "тут"], "pista": "Cada animal lleva su «mi» según el género.", "diccionario": [{"ficha": "Мой", "forma": "мой", "es": "mi", "fonetica": "moi", "porque": "Masculino: мой."}, {"ficha": "кот", "forma": "кот", "es": "gato (macho)", "fonetica": "kot", "porque": ""}, {"ficha": "там", "forma": "там", "es": "allí, allá", "fonetica": "tam", "porque": ""}, {"ficha": "а", "forma": "а", "es": "y, en cambio", "fonetica": "a", "porque": ""}, {"ficha": "моя́", "forma": "мой", "es": "mi", "fonetica": "ma-IA", "porque": "Con соба'ка (femenino): мой → моя'."}, {"ficha": "ко́шка", "forma": "ко́шка", "es": "gata", "fonetica": "KOSH-ka", "porque": ""}, {"ficha": "здесь", "forma": "здесь", "es": "aquí", "fonetica": "zdies'", "porque": ""}, {"ficha": "моё", "forma": "мой", "es": "mi", "fonetica": "ma-YO", "porque": "Con palabra neutra: мой → моё."}, {"ficha": "тут", "forma": "тут", "es": "aquí (coloquial)", "fonetica": "tut", "porque": ""}], "bloques": [["Мой", "кот", "там"], ["а"], ["моя́", "ко́шка", "здесь"]], "fijo": false, "errores": [{"tipo": "bloque", "fichas": ["Мой", "кот", "там"], "explica": "Мой, кот y там van juntos: мой кот там = mi gato está allá."}, {"tipo": "bloque", "fichas": ["моя́", "ко́шка", "здесь"], "explica": "моя́, ко́шка y здесь van juntas: моя́ ко́шка здесь = mi gata está aquí."}, {"tipo": "distractor", "ficha": "моё", "explica": "моё es neutro; кот y ко́шка piden мой / моя́."}, {"tipo": "distractor", "ficha": "тут", "explica": "тут también significa «aquí», pero esta frase usa здесь."}]},
    {"id": "hamster-tambien", "idea": "Di que tu hámster también está aquí.", "fichas": ["Мой", "хомя́к", "то́же", "здесь"], "validas": ["Мой хомя́к то́же здесь", "Мой хомя́к здесь то́же"], "texto": "Мой хомя́к то́же здесь.", "fonetica": "moi kha-MIAK TO-zhe zdies'", "es": "Mi hámster también está aquí.", "opciones": ["Mi hámster está allá.", "Mi pez también está aquí.", "Mi hámster ya no está aquí.", "Mi hámster también está aquí."], "distractores": ["ры́ба", "там"], "pista": "«También» va pegado a lo que se añade.", "diccionario": [{"ficha": "Мой", "forma": "мой", "es": "mi", "fonetica": "moi", "porque": "Masculino: мой."}, {"ficha": "хомя́к", "forma": "хомя́к", "es": "hámster", "fonetica": "kha-MIAK", "porque": ""}, {"ficha": "то́же", "forma": "то́же", "es": "también", "fonetica": "TO-zhe", "porque": ""}, {"ficha": "здесь", "forma": "здесь", "es": "aquí", "fonetica": "zdies'", "porque": ""}, {"ficha": "ры́ба", "forma": "ры́ба", "es": "pez, pescado", "fonetica": "RY-ba", "porque": ""}, {"ficha": "там", "forma": "там", "es": "allí, allá", "fonetica": "tam", "porque": ""}], "bloques": [["Мой", "хомя́к", "то́же", "здесь"]], "fijo": false, "errores": [{"tipo": "bloque", "fichas": ["Мой", "хомя́к", "то́же", "здесь"], "explica": "Estas fichas van seguidas como un solo bloque: мой хомя́к то́же здесь. то́же va después de quien también está."}, {"tipo": "distractor", "ficha": "ры́ба", "explica": "ры́ба es «pez»; la idea habla del hámster."}, {"tipo": "distractor", "ficha": "там", "explica": "там es «allá»; la idea dice «aquí»: здесь."}]},
    {"id": "no-lobo", "idea": "Aclara que no es un lobo, es un perro.", "fichas": ["Э́то", "не", "волк", "э́то", "соба́ка"], "validas": ["Э́то не волк э́то соба́ка"], "texto": "Э́то не волк, э́то соба́ка.", "fonetica": "E-ta ni volk E-ta sa-BA-ka", "es": "No es un lobo, es un perro.", "opciones": ["No es un lobo, es un perro.", "Es un lobo, no un perro.", "No es un perro, es un lobo.", "Es un lobo y también un perro."], "distractores": ["пёс", "но"], "pista": "«Не» va justo antes de lo que niegas.", "diccionario": [{"ficha": "Э́то", "forma": "э́то", "es": "esto, esto es", "fonetica": "E-ta", "porque": ""}, {"ficha": "не", "forma": "не", "es": "no (niega la palabra siguiente)", "fonetica": "ni", "porque": ""}, {"ficha": "волк", "forma": "волк", "es": "lobo", "fonetica": "volk", "porque": ""}, {"ficha": "э́то", "forma": "э́то", "es": "esto, esto es", "fonetica": "E-ta", "porque": ""}, {"ficha": "соба́ка", "forma": "соба́ка", "es": "perro, perra", "fonetica": "sa-BA-ka", "porque": ""}, {"ficha": "пёс", "forma": "пёс", "es": "perro (macho)", "fonetica": "pios", "porque": ""}, {"ficha": "но", "forma": "но", "es": "pero", "fonetica": "no", "porque": ""}], "bloques": [["Э́то", "не", "волк"], ["э́то", "соба́ка"]], "fijo": true, "errores": [{"tipo": "bloque", "fichas": ["Э́то", "не", "волк"], "explica": "Э́то, не y волк van juntas: не va justo antes de волк."}, {"tipo": "bloque", "fichas": ["э́то", "соба́ка"], "explica": "Э́то и соба́ка van juntas: э́то соба́ка = es un perro."}, {"tipo": "orden", "explica": "Primero lo que no es (э́то не волк) y luego lo que sí es (э́то соба́ка)."}, {"tipo": "distractor", "ficha": "пёс", "explica": "пёс también es «perro» (macho), pero esta frase usa соба́ка."}, {"tipo": "distractor", "ficha": "но", "explica": "но es «pero»; aquí no hace falta: э́то не волк, э́то соба́ка."}]}
